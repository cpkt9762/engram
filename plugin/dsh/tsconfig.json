{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "noEmit": true, "skipLibCheck": true, "erasableSyntaxOnly": true
  },
  "include": ["index.ts", "lib"]
}
