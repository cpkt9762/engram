From a14080db47f42dcea0efe9b261060952a45fea33 Mon Sep 17 00:00:00 2001
From: cpkt9762 <cpkt9762@163.com>
Date: Mon, 26 Oct 2026 14:05:23 +0800
Subject: [PATCH] test(ci): refresh the ci.yml baseline hash for the fork's CI
 changes

The issue-refresh-router workflow test pins a full-file hash of ci.yml. The
fork has changed ci.yml since 0016, which added the DSH adapter tests, and
0026 added the fork-rebuild trigger and the fork-release job. The pinned
upstream hash therefore failed as soon as CI ran on fork-rebuild. Pin the
current file. The other pinned workflows are still upstream's.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/scripts/issue-refresh-router-workflow.test.mjs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/.github/scripts/issue-refresh-router-workflow.test.mjs b/.github/scripts/issue-refresh-router-workflow.test.mjs
index dd1aa18..7bbb97d 100644
--- a/.github/scripts/issue-refresh-router-workflow.test.mjs
+++ b/.github/scripts/issue-refresh-router-workflow.test.mjs
@@ -61,12 +61,14 @@ test('workflow baselines retain readiness guards and pin original-event identity
   // #2017 adds only the isolated PostgreSQL job and its policy-test step; existing guards stay exact.
   // #2018 adds the independent Linux race job with its measured 20m per-binary budget;
   // existing jobs stay exact.
+  // fork: ci.yml carries fork patches 0016 (DSH adapter tests in Plugin Tests) and 0026
+  // (fork-rebuild push trigger and the fork-release job); other workflows stay upstream's.
   // Normalize to LF for Windows and archives; retain strict full-file hash comparisons.
   const baseline = {
     '.github/workflows/pr-check.yml': '33259c75e4f7dfdfca3143fc5efa0521a8ca289f06eca0d3efb429fbad7565bf',
     '.github/workflows/issue-validation.yml': 'd996ffae8e1341390b818e294a1a34a70f1b06f5eabda03cb96c0f065f7115b8',
     '.github/workflows/issue-policy.yml': '5f8bfbd9ab354f6b60d3ef35d30d5f4ee43a97eb83f61d8e0a955da37947adfd',
-    '.github/workflows/ci.yml': 'f5b4230a10f2f9cabb6b508187c8a6d7b25c3e7f0e23a5991746677dc23eaa12',
+    '.github/workflows/ci.yml': '3668866bbc240f020c45173292ddd4ddc5afba5204cf7812afddfff0230dc58d',
   };
   for (const [path, expected] of Object.entries(baseline)) {
     const source = path.endsWith('/pr-check.yml') ? read(path).replace(/^                  if \(!Array\.isArray\(issue\.labels\).+\n                    throw new Error\('issue labels are malformed'\);\n                  }\n/m, '').replace(/^                  if \(!Array\.isArray\(issue\.assignees\).+\n                    throw new Error\('issue assignees are malformed'\);\n                  }\n                  if \(issue\.assignees\.length === 0\) \{\n                    errors\.push\(.+\);\n                  }\n/m, '') : read(path);
