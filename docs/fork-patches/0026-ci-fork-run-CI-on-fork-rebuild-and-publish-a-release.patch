--- /dev/null
+++ b/.github/workflows/fork-release.yml
@@ -0,0 +1,67 @@
+name: Fork Release
+
+# Called by ci.yml once every CI job has passed on a push to fork-rebuild.
+# Publishes one GitHub release per pushed commit, tagged fork-YYYY.MM.DD.N.
+# The fork- prefix keeps upstream's v* release, image and Pi publishing
+# workflows from firing for a fork build.
+on:
+  workflow_call:
+
+permissions:
+  contents: read
+
+jobs:
+  release:
+    name: Publish Fork Release
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    permissions:
+      contents: write
+    concurrency:
+      group: fork-release
+      cancel-in-progress: false
+    env:
+      GOTOOLCHAIN: local
+    steps:
+      - name: Checkout
+        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+
+      - name: Set up Go
+        uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
+        with:
+          go-version: "1.26.10"
+
+      - name: Fetch the upstream base
+        run: git fetch --no-tags https://github.com/Gentleman-Programming/engram.git +refs/heads/main:refs/remotes/upstream/main
+
+      - name: Choose the release tag
+        id: version
+        run: bash scripts/fork-release.sh version >> "$GITHUB_OUTPUT"
+
+      - name: Skip an already released commit
+        if: steps.version.outputs.skip == 'true'
+        env:
+          TAG: ${{ steps.version.outputs.tag }}
+        run: echo "::notice::This commit is already released as ${TAG}."
+
+      - name: Build release assets
+        if: steps.version.outputs.skip != 'true'
+        env:
+          VERSION: ${{ steps.version.outputs.version }}
+        run: bash scripts/fork-release.sh build "$VERSION" dist
+
+      - name: Write release notes
+        if: steps.version.outputs.skip != 'true'
+        env:
+          TAG: ${{ steps.version.outputs.tag }}
+        run: bash scripts/fork-release.sh notes "$TAG" > release-notes.md
+
+      - name: Publish the release
+        if: steps.version.outputs.skip != 'true'
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG: ${{ steps.version.outputs.tag }}
+        run: gh release create "$TAG" dist/* --repo "$GITHUB_REPOSITORY" --target "$GITHUB_SHA" --title "$TAG" --notes-file release-notes.md
