From 1ac96589281f5cda684d88cd7ce49f570afd0d80 Mon Sep 17 00:00:00 2001
From: cpkt9762 <cpkt9762@163.com>
Date: Mon, 24 Aug 2026 01:55:13 +0800
Subject: [PATCH] fix(store): make prompt import idempotent like observations

Store.Import guards sessions with INSERT OR IGNORE and observations with
WHERE NOT EXISTS on sync_id, but prompts were inserted unconditionally.
Re-running `engram import` on the same export therefore duplicated every
prompt while leaving sessions and observations untouched.

Reproduced while importing a 2906-prompt export twice: user_prompts grew
to 5812 rows with 2906 distinct sync_ids, each appearing exactly twice.
That makes a bulk migration non-retryable -- any interrupted or repeated
import silently doubles the prompt corpus, and prompts_fts doubles with
it, skewing search results.

PromptsImported now counts rows actually affected rather than loop
iterations, so the reported total matches what was stored.

Prompts arriving without a sync_id still get a generated one and are
always inserted; the guard only suppresses exact sync_id repeats.
---
 internal/store/store.go      | 13 ++++--
 internal/store/store_test.go | 89 ++++++++++++++++++++++++++++++++++++
 2 files changed, 97 insertions(+), 5 deletions(-)

diff --git a/internal/store/store.go b/internal/store/store.go
index 4b16895..d0d90e9 100644
--- a/internal/store/store.go
+++ b/internal/store/store.go
@@ -3715,17 +3715,20 @@ func (s *Store) Import(data *ExportData) (*ImportResult, error) {
 		result.ObservationsImported += int(n)
 	}
 
-	// Import prompts
+	// Import prompts (skip duplicate sync IDs, same as observations above)
 	for _, p := range data.Prompts {
-		_, err := s.execHook(tx,
+		syncID := normalizeExistingSyncID(p.SyncID, "prompt")
+		res, err := s.execHook(tx,
 			`INSERT INTO user_prompts (sync_id, session_id, content, project, created_at)
-			 VALUES (?, ?, ?, ?, ?)`,
-			normalizeExistingSyncID(p.SyncID, "prompt"), p.SessionID, p.Content, p.Project, p.CreatedAt,
+			 SELECT ?, ?, ?, ?, ?
+			 WHERE NOT EXISTS (SELECT 1 FROM user_prompts WHERE sync_id = ?)`,
+			syncID, p.SessionID, p.Content, p.Project, p.CreatedAt, syncID,
 		)
 		if err != nil {
 			return nil, fmt.Errorf("import prompt %d: %w", p.ID, err)
 		}
-		result.PromptsImported++
+		n, _ := res.RowsAffected()
+		result.PromptsImported += int(n)
 	}
 
 	if err := s.commitHook(tx); err != nil {
