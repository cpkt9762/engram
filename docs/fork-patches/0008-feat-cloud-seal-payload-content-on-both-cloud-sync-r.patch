+func TestCloudImportWithWrongKeyFailsLoudly(t *testing.T) {
+	src := newTestStore(t)
+	seedStoreForSync(t, src)
+	if err := src.EnrollProject("proj-a"); err != nil {
+		t.Fatalf("enroll src: %v", err)
