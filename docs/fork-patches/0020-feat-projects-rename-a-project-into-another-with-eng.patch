diff --git a/cmd/engram/project_rename.go b/cmd/engram/project_rename.go
new file mode 100644
index 0000000..428c2c0
--- /dev/null
+++ b/cmd/engram/project_rename.go
@@ -0,0 +1,125 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+
+	"github.com/Gentleman-Programming/engram/v3/internal/store"
+)
+
+// A narrow seam lets tests prove backup failure prevents any migration.
+var projectsRenameBackup = (*store.Store).BackupSQLite
+
+func cmdProjectsRename(cfg store.Config) {
+	fail := func(err error) { fmt.Fprintf(os.Stderr, "projects rename: %v\n", err); exitFunc(1) }
+	var from, to string
+	var dryRun, apply bool
+	seen := map[string]bool{}
+	for i := 3; i < len(os.Args); i++ {
+		flag := os.Args[i]
+		if seen[flag] {
+			fail(fmt.Errorf("duplicate argument %s", flag))
+			return
+		}
+		seen[flag] = true
+		switch flag {
+		case "--from", "--to":
+			if i+1 >= len(os.Args) || strings.HasPrefix(os.Args[i+1], "--") {
+				fail(fmt.Errorf("%s requires a value", flag))
+				return
+			}
+			i++
+			if flag == "--from" {
+				from = os.Args[i]
+			} else {
+				to = os.Args[i]
+			}
+		case "--dry-run":
+			dryRun = true
+		case "--apply":
+			apply = true
+		default:
+			fail(fmt.Errorf("unknown argument %q", flag))
+			return
+		}
+	}
+	if !seen["--from"] || !seen["--to"] || dryRun == apply {
+		fail(fmt.Errorf("usage: engram projects rename --from <source> --to <target> (--dry-run|--apply)"))
+		return
+	}
+	s, err := storeNew(cfg)
+	if err != nil {
+		fail(err)
+		return
+	}
+	defer func() { _ = s.Close() }()
+	preview, err := s.PreviewProjectRename(from, to)
+	if err != nil {
+		fail(err)
+		return
+	}
+	printProjectRenamePreflight(preview)
+	action := "rename"
+	if preview.TargetExists {
+		action = "merge"
+	}
+	if dryRun {
+		fmt.Printf("[dry-run] %s %q -> %q (source enrolled: %t, target enrolled: %t)\n", action, preview.Source, preview.Target, preview.SourceEnrolled, preview.TargetEnrolled)
+		printProjectRenameCounts(preview.Tables)
+		fmt.Println("No changes made. Point-in-time preview; apply revalidates and counts may differ.")
+		return
+	}
+	if err := preview.CheckSyncLease(); err != nil {
+		fail(err)
+		return
+	}
+	backup, err := projectsRenameBackup(s)
+	if err != nil {
+		fail(err)
+		return
+	}
+	fmt.Printf("Backup: %s\n", backup)
+	result, err := s.RenameProject(preview.Source, preview.Target)
+	if err != nil {
+		fail(err)
+		return
+	}
+	if !result.Migrated {
+		fail(fmt.Errorf("source project %q does not exist", preview.Source))
+		return
+	}
+	fmt.Printf("%s %q -> %q\n", action, preview.Source, preview.Target)
+	printProjectRenameCounts(result.Tables)
+	fmt.Println("Previously synced records will be re-pushed under the new name when enrolled.")
+	fmt.Println("Cloud history under the old project name is append-only and will remain unchanged.")
+}
+
+func printProjectRenameCounts(counts map[string]int64) {
+	tables := make([]string, 0, len(counts))
+	for table := range counts {
+		tables = append(tables, table)
+	}
+	sort.Strings(tables)
+	for _, table := range tables {
+		fmt.Printf("  %s: %d\n", table, counts[table])
+	}
+}
+
+func printProjectRenamePreflight(p *store.ProjectRenamePreview) {
+	fmt.Printf("Unacknowledged sync mutations — pending: %d, quarantined: %d\n", p.PendingMutations, p.QuarantinedMutations)
+	if len(p.SyncLeases) == 0 {
+		fmt.Println("Sync lease: owner=\"\" until=\"\" active=false (no targets)")
+	}
+	for _, lease := range p.SyncLeases {
+		fmt.Printf("Sync lease %q: owner=%q until=%q active=%t\n", lease.TargetKey, lease.Owner, lease.Until, lease.Active)
+	}
+	fmt.Printf("Source keyed prompts: %d\n", p.KeyedPrompts)
+	if p.KeyedPrompts > 0 {
+		fmt.Printf("Warning: %d keyed prompts retain local creation source %q; after rename their cloud sync will stop at prompt_provenance_blocked.\n", p.KeyedPrompts, p.Source)
+	}
+	if p.QuarantinedMutations > 0 {
+		fmt.Printf("Warning: %d quarantined mutations count as covered by sync backfill but are never sent; these entities will not be pushed under %q.\n", p.QuarantinedMutations, p.Target)
+	}
+}
diff --git a/cmd/engram/project_rename_test.go b/cmd/engram/project_rename_test.go
new file mode 100644
index 0000000..33cacbc
--- /dev/null
+++ b/cmd/engram/project_rename_test.go
@@ -0,0 +1,245 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Gentleman-Programming/engram/v3/internal/store"
+)
+
+func renameCommandSnapshot(t *testing.T, cfg store.Config) string {
+	t.Helper()
+	s, err := store.New(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := s.Close(); err != nil {
+			t.Errorf("close snapshot store: %v", err)
+		}
+	}()
+	exported, err := s.Export()
+	if err != nil {
+		t.Fatal(err)
+	}
+	exported.ExportedAt = ""
+	counts := map[string]int{}
+	for _, table := range []string{"sessions", "observations", "user_prompts", "sync_mutations", "sync_enrolled_projects", "prompt_tombstones", "sync_delete_tombstones", "project_aliases"} {
+		var n int
+		if err := s.DB().QueryRow("SELECT count(*) FROM " + table).Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		counts[table] = n
+	}
+	b, err := json.Marshal([]any{exported, counts})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
+
+func TestProjectsRenameCommand(t *testing.T) {
+	cfg := testConfig(t)
+	mustSeedObservation(t, cfg, "s", "source", "note", "searchable", "套利", "project")
+	mustSeedObservation(t, cfg, "t", "target", "note", "existing", "other", "project")
+	before := renameCommandSnapshot(t, cfg)
+	withArgs(t, "engram", "projects", "rename", "--from", " SOURCE ", "--to", "TARGET", "--dry-run")
+	out, stderr := captureOutput(t, func() { cmdProjects(cfg) })
+	if stderr != "" || !strings.Contains(out, "merge") || !strings.Contains(out, "observations: 1") || !strings.Contains(out, "source enrolled: false") {
+		t.Fatalf("out=%q stderr=%q", out, stderr)
+	}
+	if before != renameCommandSnapshot(t, cfg) {
+		t.Fatal("dry-run mutated DB")
+	}
+	backups, err := filepath.Glob(filepath.Join(cfg.DataDir, "*.db*"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	beforeFiles := map[string]bool{}
+	for _, p := range backups {
+		beforeFiles[p] = true
+	}
+	withArgs(t, "engram", "projects", "rename", "--from", "source", "--to", "target", "--apply")
+	out, stderr = captureOutput(t, func() { cmdProjects(cfg) })
+	if stderr != "" || !strings.Contains(out, "Backup:") || !strings.Contains(out, "observations: 1") || !strings.Contains(out, "re-pushed") || !strings.Contains(out, "append-only") {
+		t.Fatalf("out=%q stderr=%q", out, stderr)
+	}
+	var backup string
+	for _, line := range strings.Split(out, "\n") {
+		if strings.HasPrefix(line, "Backup: ") {
+			backup = strings.TrimPrefix(line, "Backup: ")
+		}
+	}
+	info, err := os.Stat(backup)
+	if err != nil || info.Size() == 0 || beforeFiles[backup] {
+		t.Fatalf("backup=%q stat=%v err=%v", backup, info, err)
+	}
+	// Read the backup independently; it must contain the pre-rename owner.
+	data, err := os.ReadFile(backup)
+	if err != nil {
+		t.Fatal(err)
+	}
+	backupDir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(backupDir, "engram.db"), data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	backupCfg := cfg
+	backupCfg.DataDir = backupDir
+	if before != renameCommandSnapshot(t, backupCfg) {
+		t.Fatal("backup does not preserve pre-apply data")
+	}
+	oldExit := exitFunc
+	exitFunc = func(code int) { panic(exitCode(code)) }
+	t.Cleanup(func() { exitFunc = oldExit })
+	after := renameCommandSnapshot(t, cfg)
+	_, stderr, recovered := captureOutputAndRecover(t, func() { cmdProjects(cfg) })
+	if recovered != exitCode(1) || !strings.HasPrefix(stderr, "projects rename:") || !strings.Contains(stderr, "does not exist") {
+		t.Fatalf("stderr=%q exit=%v", stderr, recovered)
+	}
+	if after != renameCommandSnapshot(t, cfg) {
+		t.Fatal("repeat mutated DB")
+	}
+}
+
+func TestProjectsRenameBackupFailure(t *testing.T) {
+	cfg := testConfig(t)
+	mustSeedObservation(t, cfg, "s", "source", "note", "test", "content", "project")
+	before := renameCommandSnapshot(t, cfg)
+	original := projectsRenameBackup
+	projectsRenameBackup = func(*store.Store) (string, error) { return "", errors.New("backup unavailable") }
+	t.Cleanup(func() { projectsRenameBackup = original })
+	oldExit := exitFunc
+	exitFunc = func(code int) { panic(exitCode(code)) }
+	t.Cleanup(func() { exitFunc = oldExit })
+	withArgs(t, "engram", "projects", "rename", "--from", "source", "--to", "target", "--apply")
+	_, stderr, recovered := captureOutputAndRecover(t, func() { cmdProjects(cfg) })
+	if recovered != exitCode(1) || !strings.Contains(stderr, "projects rename: backup unavailable") {
+		t.Fatalf("stderr=%q exit=%v", stderr, recovered)
+	}
+	if before != renameCommandSnapshot(t, cfg) {
+		t.Fatal("backup failure mutated DB")
+	}
+}
+
+func TestProjectsRenameInvalidInputs(t *testing.T) {
+	cfg := testConfig(t)
+	mustSeedObservation(t, cfg, "s", "source", "note", "test", "content", "project")
+	before := renameCommandSnapshot(t, cfg)
+	oldExit := exitFunc
+	exitFunc = func(code int) { panic(exitCode(code)) }
+	t.Cleanup(func() { exitFunc = oldExit })
+	for _, args := range [][]string{
+		{}, {"--from", "source", "--to", "target"}, {"--from", "source", "--to", "target", "--apply", "--dry-run"},
+		{"--from", "source", "--apply"}, {"--to", "target", "--apply"}, {"--from", "source", "--to", "target", "--apply", "--apply"},
+		{"--from", "source", "--to", "target", "--apply", "--unknown"}, {"--from", "missing", "--to", "target", "--apply"},
+		{"--from", "source", "--to", " SOURCE ", "--apply"}, {"--from", "source", "--to", "inbox", "--apply"},
+		{"--from", "source", "--to", "", "--apply"}, {"--from", "source", "--to", "a/b", "--apply"},
+		{"--from", "source", "--to", "a\\b", "--apply"}, {"--from", "source", "--to", "a\nb", "--apply"},
+		{"--from", "source", "--to", "target", "--to", "other", "--apply"}, {"--from"},
+	} {
+		withArgs(t, append([]string{"engram", "projects", "rename"}, args...)...)
+		out, stderr, recovered := captureOutputAndRecover(t, func() { cmdProjects(cfg) })
+		if recovered != exitCode(1) || out != "" || !strings.HasPrefix(stderr, "projects rename:") {
+			t.Fatalf("args=%q out=%q stderr=%q exit=%v", args, out, stderr, recovered)
+		}
+		if before != renameCommandSnapshot(t, cfg) {
+			t.Fatalf("invalid input mutated DB: %q", args)
+		}
+	}
+}
+
+func TestProjectsRenameGuardBeforeBackup(t *testing.T) {
+	cfg := testConfig(t)
+	mustSeedObservation(t, cfg, "s", "source", "note", "test", "content", "project")
+	s, err := store.New(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.EnrollProject("source"); err != nil {
+		t.Fatal(err)
+	}
+	acquired, err := s.AcquireSyncLease("cloud", "cli-autosync", time.Minute, time.Now())
+	if err != nil || !acquired {
+		t.Fatalf("lease=%t err=%v", acquired, err)
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	before := renameCommandSnapshot(t, cfg)
+	original := projectsRenameBackup
+	calls := 0
+	projectsRenameBackup = func(*store.Store) (string, error) { calls++; return "", errors.New("backup must not run") }
+	t.Cleanup(func() { projectsRenameBackup = original })
+	oldExit := exitFunc
+	exitFunc = func(code int) { panic(exitCode(code)) }
+	t.Cleanup(func() { exitFunc = oldExit })
+	for _, mode := range []string{"--dry-run", "--apply"} {
+		withArgs(t, "engram", "projects", "rename", "--from", "source", "--to", "target", mode)
+		out, stderr, recovered := captureOutputAndRecover(t, func() { cmdProjects(cfg) })
+		for _, text := range []string{"pending: 2", "quarantined: 0", "owner=\"cli-autosync\"", "active=true", "until="} {
+			if !strings.Contains(out, text) {
+				t.Fatalf("missing %q in %q", text, out)
+			}
+		}
+		if mode == "--apply" {
+			if recovered != exitCode(1) || !strings.Contains(stderr, "engram cloud status") || !strings.Contains(stderr, "cli-autosync") {
+				t.Fatalf("stderr=%q exit=%v", stderr, recovered)
+			}
+		} else if recovered != nil || stderr != "" {
+			t.Fatalf("dry run stderr=%q exit=%v", stderr, recovered)
+		}
+	}
+	if calls != 0 {
+		t.Fatalf("backups=%d", calls)
+	}
+	if before != renameCommandSnapshot(t, cfg) {
+		t.Fatal("guard changed DB")
+	}
+}
+
+func TestProjectsRenameWarnings(t *testing.T) {
+	for _, mode := range []string{"--dry-run", "--apply"} {
+		t.Run(mode, func(t *testing.T) {
+			cfg := testConfig(t)
+			mustSeedObservation(t, cfg, "s", "source", "note", "test", "content", "project")
+			s, err := store.New(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := s.AddPrompt(store.AddPromptParams{SessionID: "s", Project: "source", Content: "keyed", SourceInboxID: "key"}); err != nil {
+				t.Fatal(err)
+			}
+			if err := s.EnrollProject("source"); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := s.DB().Exec(`UPDATE sync_mutations SET disposition='quarantined'`); err != nil {
+				t.Fatal(err)
+			}
+			acquired, err := s.AcquireSyncLease("cloud", "warning-autosync", time.Minute, time.Now())
+			if err != nil || !acquired {
+				t.Fatalf("lease=%t err=%v", acquired, err)
+			}
+			if err := s.Close(); err != nil {
+				t.Fatal(err)
+			}
+			withArgs(t, "engram", "projects", "rename", "--from", "source", "--to", "target", mode)
+			out, stderr := captureOutput(t, func() { cmdProjects(cfg) })
+			if stderr != "" {
+				t.Fatalf("stderr=%q", stderr)
+			}
+			for _, text := range []string{"pending: 0", "quarantined: 3", "keyed prompts: 1", "prompt_provenance_blocked", "source", "covered", "never sent", "active=true"} {
+				if !strings.Contains(out, text) {
+					t.Fatalf("missing %q in %q", text, out)
+				}
+			}
+			if mode == "--apply" && !strings.Contains(out, "Backup:") {
+				t.Fatal("warnings prevented apply")
+			}
+		})
+	}
+}
diff --git a/internal/store/project_rename.go b/internal/store/project_rename.go
new file mode 100644
index 0000000..0bb7bf0
--- /dev/null
+++ b/internal/store/project_rename.go
@@ -0,0 +1,250 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"time"
+	"unicode"
+)
+
+// ProjectRenamePreview describes current ownership only. Historical identities
+// (including acknowledged mutations) are not evidence of a live source project.
+// Counts describe rows moved, before any new sync backfill rows are appended.
+type ProjectRenamePreview struct {
+	Source               string               `json:"source"`
+	Target               string               `json:"target"`
+	TargetExists         bool                 `json:"target_exists"`
+	SourceEnrolled       bool                 `json:"source_enrolled"`
+	TargetEnrolled       bool                 `json:"target_enrolled"`
+	Tables               map[string]int64     `json:"tables"`
+	PendingMutations     int64                `json:"pending_mutations"`
+	QuarantinedMutations int64                `json:"quarantined_mutations"`
+	KeyedPrompts         int64                `json:"keyed_prompts"`
+	SyncLeases           []ProjectRenameLease `json:"sync_leases"`
+}
+
+// A push can outlive the usual 60-second lease TTL. A crashed owner's
+// expired lease therefore blocks rename for at most five additional minutes.
+const projectRenameLeaseGrace = 5 * time.Minute
+
+const projectRenameMutationPredicate = `acked_at IS NULL AND (project = @source OR (json_valid(payload) AND json_extract(payload, '$.project') = @source))`
+
+// ProjectRenameLease reports each target, including inactive or ownerless leases.
+type ProjectRenameLease struct {
+	TargetKey string `json:"target_key"`
+	Owner     string `json:"owner"`
+	Until     string `json:"until"`
+	Active    bool   `json:"active"`
+}
+
+// CheckSyncLease is shared by the CLI's pre-backup check and the authoritative
+// write-transaction check. Quarantined rows cannot be in flight.
+func (p *ProjectRenamePreview) CheckSyncLease() error {
+	if p.PendingMutations == 0 {
+		return nil
+	}
+	for _, lease := range p.SyncLeases {
+		if lease.Active {
+			return fmt.Errorf("cannot rename project %q: %d unacknowledged pending sync mutations with active lease owner=%q lease_until=%q (target=%q); wait until engram cloud status shows pending cleared, or stop autosync before retrying", p.Source, p.PendingMutations, lease.Owner, lease.Until, lease.TargetKey)
+		}
+	}
+	return nil
+}
+
+// projectRenamePreflight observes the same source scope as migration. Call it
+// inside the apply transaction as well as the read-only preview transaction.
+func projectRenamePreflight(q projectRenameQuerier, source string) (*ProjectRenamePreview, error) {
+	p := &ProjectRenamePreview{Source: source, SyncLeases: []ProjectRenameLease{}}
+	if err := q.QueryRow(`SELECT count(*) FILTER (WHERE disposition='pending'), count(*) FILTER (WHERE disposition='quarantined') FROM sync_mutations WHERE `+projectRenameMutationPredicate, sql.Named("source", source)).Scan(&p.PendingMutations, &p.QuarantinedMutations); err != nil {
+		return nil, fmt.Errorf("preflight rename mutations: %w", err)
+	}
+	if err := q.QueryRow(`SELECT count(*) FROM user_prompts WHERE project=? AND source_inbox_id IS NOT NULL AND source_inbox_id != ''`, source).Scan(&p.KeyedPrompts); err != nil {
+		return nil, fmt.Errorf("preflight rename keyed prompts: %w", err)
+	}
+	rows, err := q.Query(`SELECT target_key,coalesce(lease_owner,''),coalesce(lease_until,''),coalesce(lease_owner != '' AND julianday(lease_until) > julianday(?),0) FROM sync_state ORDER BY target_key`, time.Now().UTC().Add(-projectRenameLeaseGrace).Format(time.RFC3339Nano))
+	if err != nil {
+		return nil, fmt.Errorf("preflight rename leases: %w", err)
+	}
+	defer func() { _ = rows.Close() }()
+	for rows.Next() {
+		var lease ProjectRenameLease
+		if err := rows.Scan(&lease.TargetKey, &lease.Owner, &lease.Until, &lease.Active); err != nil {
+			return nil, fmt.Errorf("scan rename lease: %w", err)
+		}
+		p.SyncLeases = append(p.SyncLeases, lease)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("read rename leases: %w", err)
+	}
+	return p, nil
+}
+
+// RenameProject is the guarded projects-rename entry point. MigrateProject keeps
+// its existing semantics for interactive consolidation.
+func (s *Store) RenameProject(from, to string) (*MigrateResult, error) {
+	from, to, err := normalizeProjectRename(from, to)
+	if err != nil {
+		return nil, err
+	}
+	return s.migrateProject(from, to, true)
+}
+
+// The predicates below define both preview counts and apply eligibility. SQL
+// identifiers are constants, never project names supplied by a caller.
+type projectRenameScope struct {
+	table       string
+	predicate   string
+	assignments string
+}
+
+func projectRenameScopes() []projectRenameScope {
+	scopes := make([]projectRenameScope, 0, 8)
+	for _, table := range []string{"observations", "sessions", "user_prompts", "prompt_tombstones", "sync_delete_tombstones", "project_aliases"} {
+		predicate := "project = @source"
+		if table == "sync_delete_tombstones" {
+			// A whole-project delete is evidence about the old identity, not a
+			// transportable entity delete. Moving it would invalidate its key/project
+			// pair and could resurrect stale history (or delete the merge target).
+			predicate += " AND entity != 'project'"
+		}
+		scopes = append(scopes, projectRenameScope{table, predicate, "project = @target"})
+	}
+	scopes = append(scopes,
+		projectRenameScope{"sync_mutations", projectRenameMutationPredicate,
+			`project = @target, payload = CASE WHEN json_valid(payload) AND json_extract(payload, '$.project') = @source THEN json_set(payload, '$.project', @target) ELSE payload END`},
+		projectRenameScope{"sync_enrolled_projects", "project = @source", ""},
+	)
+	return scopes
+}
+
+func normalizeProjectRename(from, to string) (string, string, error) {
+	// Inspect raw inputs as well: normalization trims edge controls, but they are
+	// invalid CLI names rather than an alternative spelling of a valid name.
+	for _, name := range []string{from, to} {
+		if strings.ContainsAny(name, "/\\") || strings.ContainsFunc(name, unicode.IsControl) {
+			return "", "", fmt.Errorf("project names must not contain path separators or control characters")
+		}
+	}
+	from, _ = NormalizeProject(from)
+	to, _ = NormalizeProject(to)
+	switch {
+	case from == "" || to == "":
+		return "", "", fmt.Errorf("source and target project names are required")
+	case from == to:
+		return "", "", fmt.Errorf("source and target normalize to the same project")
+	case to == ReservedInboxProjectName:
+		return "", "", fmt.Errorf("target cannot be reserved project %q", to)
+	}
+	return from, to, nil
+}
+
+type projectRenameQuerier interface {
+	QueryRow(string, ...any) *sql.Row
+	Query(string, ...any) (*sql.Rows, error)
+}
+
+func projectRenameCounts(q projectRenameQuerier, source string) (map[string]int64, error) {
+	counts := make(map[string]int64)
+	for _, scope := range projectRenameScopes() {
+		var count int64
+		if err := q.QueryRow("SELECT count(*) FROM "+scope.table+" WHERE "+scope.predicate, sql.Named("source", source)).Scan(&count); err != nil {
+			return nil, fmt.Errorf("count rename %s: %w", scope.table, err)
+		}
+		counts[scope.table] = count
+	}
+	return counts, nil
+}
+
+func projectRenameExists(counts map[string]int64) bool {
+	for _, count := range counts {
+		if count > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// PreviewProjectRename uses a read-only transaction to observe a consistent
+// point-in-time scope. It neither migrates nor queues any records.
+func (s *Store) PreviewProjectRename(from, to string) (*ProjectRenamePreview, error) {
+	from, to, err := normalizeProjectRename(from, to)
+	if err != nil {
+		return nil, err
+	}
+	tx, err := s.db.BeginTx(context.Background(), &sql.TxOptions{ReadOnly: true})
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback() }()
+	source, err := projectRenameCounts(tx, from)
+	if err != nil {
+		return nil, err
+	}
+	if !projectRenameExists(source) {
+		return nil, fmt.Errorf("source project %q does not exist", from)
+	}
+	target, err := projectRenameCounts(tx, to)
+	if err != nil {
+		return nil, err
+	}
+	preview, err := projectRenamePreflight(tx, from)
+	if err != nil {
+		return nil, err
+	}
+	preview.Target = to
+	preview.TargetExists = projectRenameExists(target)
+	preview.SourceEnrolled = source["sync_enrolled_projects"] > 0
+	preview.TargetEnrolled = target["sync_enrolled_projects"] > 0
+	preview.Tables = source
+	return preview, nil
+}
+
+func (s *Store) applyProjectRenameTx(tx *sql.Tx, from, to string) (map[string]int64, error) {
+	scopes := projectRenameScopes()
+	counts, err := s.applyProjectRenameScopesTx(tx, from, to, scopes[:len(scopes)-2])
+	if err != nil {
+		return nil, err
+	}
+	// The existing sync-identity entry point shares the same scopes for one
+	// exact source; multi-source consolidation retains its existing behavior.
+	syncCounts, err := projectRenameCounts(tx, from)
+	if err != nil {
+		return nil, err
+	}
+	if err := s.migrateProjectSyncIdentityTx(tx, []string{from}, to); err != nil {
+		return nil, err
+	}
+	for _, scope := range scopes[len(scopes)-2:] {
+		counts[scope.table] = syncCounts[scope.table]
+	}
+	return counts, nil
+}
+
+func (s *Store) applyProjectRenameScopesTx(tx *sql.Tx, from, to string, scopes []projectRenameScope) (map[string]int64, error) {
+	counts := make(map[string]int64)
+	for _, scope := range scopes {
+		if scope.table == "sync_enrolled_projects" {
+			if _, err := s.execHook(tx, `INSERT OR IGNORE INTO sync_enrolled_projects(project) SELECT @target WHERE EXISTS (SELECT 1 FROM sync_enrolled_projects WHERE `+scope.predicate+`)`, sql.Named("target", to), sql.Named("source", from)); err != nil {
+				return nil, fmt.Errorf("carry rename enrollment: %w", err)
+			}
+		}
+		query := "UPDATE " + scope.table + " SET " + scope.assignments + " WHERE " + scope.predicate
+		args := []any{sql.Named("target", to), sql.Named("source", from)}
+		if scope.table == "sync_enrolled_projects" {
+			query = "DELETE FROM " + scope.table + " WHERE " + scope.predicate
+			args = []any{sql.Named("source", from)}
+		}
+		res, err := s.execHook(tx, query, args...)
+		if err != nil {
+			return nil, fmt.Errorf("rename %s: %w", scope.table, err)
+		}
+		count, err := res.RowsAffected()
+		if err != nil {
+			return nil, err
+		}
+		counts[scope.table] = count
+	}
+	return counts, nil
+}
