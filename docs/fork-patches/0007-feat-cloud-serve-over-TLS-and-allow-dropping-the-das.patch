 	return func(s *CloudServer) {
 		if limit > 0 {
@@ -158,7 +203,8 @@ func New(store ChunkStore, authSvc Authenticator, port int, opts ...Option) *Clo
 			ReasonCode:    constants.ReasonTransportFailed,
