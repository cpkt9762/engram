From 8bb30282da8b6ecd17a2466ec84b3e10ce806616 Mon Sep 17 00:00:00 2001
From: cpkt9762 <cpkt9762@163.com>
Date: Mon, 24 Aug 2026 01:49:44 +0800
Subject: [PATCH] fix(store): raise MaxSearchResults from 20 to 100

Search results were silently capped at 20 regardless of the requested
limit: Store.Search clamps `limit` to cfg.MaxSearchResults, so
`engram search <q> --limit 1000` returned 20 rows with no indication
that truncation happened.

20 is too low for a memory store holding tens of thousands of
observations, especially for CJK corpora where a common two-character
term legitimately matches hundreds of rows.

Both construction sites are updated. Changing only DefaultConfig would
leave the FallbackConfig path (used when the home directory cannot be
resolved) still capped at 20.

MaxContextResults is deliberately left at 20 -- that governs automatic
session-start context injection, where a larger value costs prompt
budget on every session.
---
 internal/store/store.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/internal/store/store.go b/internal/store/store.go
index 950e2ea..d3b7676 100644
--- a/internal/store/store.go
+++ b/internal/store/store.go
@@ -870,7 +870,7 @@ func DefaultConfig() (Config, error) {
 		DataDir:              filepath.Join(home, ".engram"),
 		MaxObservationLength: 50000,
 		MaxContextResults:    20,
-		MaxSearchResults:     20,
+		MaxSearchResults:     100,
 		DedupeWindow:         15 * time.Minute,
 	}, nil
 }
@@ -883,7 +883,7 @@ func FallbackConfig(dataDir string) Config {
 		DataDir:              dataDir,
 		MaxObservationLength: 50000,
 		MaxContextResults:    20,
-		MaxSearchResults:     20,
+		MaxSearchResults:     100,
 		DedupeWindow:         15 * time.Minute,
 	}
 }
