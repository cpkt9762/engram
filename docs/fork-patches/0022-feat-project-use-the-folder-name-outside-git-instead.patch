+func TestNonGitParentUsesOwnFolder(t *testing.T) {
+	for _, children := range []int{1, 2} {
+		t.Run(string(rune('0'+children)), func(t *testing.T) {
+			parent := filepath.Join(t.TempDir(), "my-workspace")
+			if err := os.Mkdir(parent, 0o755); err != nil {
+				t.Fatal(err)
