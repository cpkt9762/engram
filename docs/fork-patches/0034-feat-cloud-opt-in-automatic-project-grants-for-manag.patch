+					t.Fatalf("baseline log sequence changed: %q", logs.String())
+				}
+				wantEvents := []cloudstore.AuthAuditEvent(nil)
+				if withAudit {
+					wantEvents = []cloudstore.AuthAuditEvent{wantEvent, wantEvent, wantEvent}
