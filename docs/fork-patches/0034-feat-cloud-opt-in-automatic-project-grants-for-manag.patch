+				if !reflect.DeepEqual(audit.auditEvents, wantEvents) || f.calls != 0 || len(f.events) != 0 {
+					t.Fatalf("baseline audit changed: events=%+v grantCalls=%d grantEvents=%+v", audit.auditEvents, f.calls, f.events)
