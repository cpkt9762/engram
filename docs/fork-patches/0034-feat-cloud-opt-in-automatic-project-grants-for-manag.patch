+		cfg.AutoGrant = enabled
+		cfg.AutoGrantMax = 17
+		s := cloudserver.New(runtimeOptionTestStore{}, a, 0, cloudRuntimeServerOptions(cfg, nil, []string{"unrelated"}, a, nil, f)...)
