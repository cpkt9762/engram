+  const h = await setup(t, (req, res) => json(res, missing ? {} : { ...contract(), revision: 999 }, missing ? 404 : 200))
+  for (let i = 0; i < 3; i++) await assert.rejects(h.tools.mem_current_project.execute({}, { agent: h.host }), /projection mismatch/)
