+  h.events['agent/inbox/inserted']({ agent: h.host, message: { source: { kind: 'user' }, content: [{ type: 'text', text: 'one-off capture failure must remain a warning' }] } })
+  await h.events['agent/turn-stopping']({ agent: h.host })
