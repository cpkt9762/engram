+      "method": "POST",
+      "path": "/runtime-sessions/end",
+      "server_contract": "runtime-session-end/v1"
+    },
+    "runtime-session-resolve": {
+      "method": "POST",
+      "path": "/runtime-sessions/resolve",
+      "server_contract": "runtime-session-resolve/v1"
