+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-tools'
+import type {} from '@deepseek-ai/dsh-system-prompt'
+import { parseConfig } from './lib/config.ts'
+import { Runtime } from './lib/runtime.ts'
+import { createTools } from './lib/tools.ts'
+import { MEMORY_INSTRUCTIONS } from './lib/protocol.ts'
+
+export const name = 'engram-dsh'
+export const inject = ['tools', 'systemPrompt']
+export function apply(ctx: Context, config: unknown): void {
+  const settings = parseConfig(config)
+  const logger = ctx.logger('engram-dsh')
+  const runtime = new Runtime(settings, Date.now, logger)
+  const report = (label: string, error: unknown) => runtime.report(label, error)
+  const tools = createTools(runtime)
+  for (const definition of tools) ctx.tools.register(definition)
+  const ownTools = new Set(tools.map(tool => tool.name))
+  ctx.systemPrompt.section({ name: 'engram-dsh:memory-protocol', order: 9950, interpolate: false, text: MEMORY_INSTRUCTIONS })
+  ctx.systemPrompt.context({ name: 'engram-dsh:compaction-recovery', order: 130, text: context => runtime.compaction.notice(context.agent?.id) })
+  ctx.effect(() => () => runtime.close(), 'engram-dsh.runtime')
+  ctx.on('agent/created', payload => {
+    try { void runtime.prepare(payload.agent).catch(error => { report('Engram warmup failed', error) }) }
+    catch (error) { report('Engram warmup failed', error) }
+    return undefined
+  })
+  ctx.on('agent/inbox/inserted', payload => {
+    try { runtime.capture.inbox(payload.agent, payload.message) }
+    catch (error) { report('Engram inbox capture failed', error) }
+    return undefined
+  })
+  ctx.on('tools/result', (exec, result) => {
+    try { runtime.capture.result(exec, result, ownTools) }
+    catch (error) { report('Engram tool capture failed', error) }
+    return undefined
+  })
+  ctx.on('session/event', (session, event) => {
+    try { runtime.compaction.event(session, event) }
+    catch (error) { report('Engram compaction capture failed', error) }
+    return undefined
+  })
+  ctx.on('agent/turn-stopping', payload => {
+    try {
+      const id = payload.agent.id
+      runtime.capture.endTurn(id)
+      return runtime.queue.drain(id).then(() => { runtime.compaction.clearDelivered(id) })
+        .catch(error => { report('Engram queue drain failed', error) })
+    } catch (error) { report('Engram queue drain failed', error); return undefined }
+  })
+  ctx.on('agent/disposed', payload => {
+    try { runtime.dispose(payload.agent.id) }
+    catch (error) { report('Engram disposal failed', error) }
+    return undefined
+  })
+}
diff --git a/plugin/dsh/lib/capture.ts b/plugin/dsh/lib/capture.ts
new file mode 100644
index 0000000..145a08d
--- /dev/null
+++ b/plugin/dsh/lib/capture.ts
@@ -0,0 +1,57 @@
+import type { Runtime } from './runtime.ts'
+import type { Agent } from './project.ts'
+import { redactPrivateTags } from './redaction.ts'
+
+export function textBlocks(content: unknown): string {
+  if (!Array.isArray(content)) return ''
+  return content.filter(block => block && block.type === 'text' && typeof block.text === 'string').map(block => block.text).join('\n')
+}
+export function isSubagent(agent: Agent): boolean {
+  const header = agent.session.header
+  return header.origin === 'subagent' || (header.delegationDepth ?? 0) > 0
+}
+interface Prompt { turn: object; content: string; project: string; effectiveId: string }
+export class Capture {
+  private runtime: Runtime
+  private turns = new Map<string, object>()
+  private prompts = new Map<string, Prompt>()
+  constructor(runtime: Runtime) { this.runtime = runtime }
+  inbox(agent: Agent, message: unknown): void {
+    if (isSubagent(agent)) return
+    const input = message as { source?: { kind?: string }; content?: unknown } | null
+    if (input?.source?.kind !== 'user') return
+    const turn = {}
+    this.turns.set(agent.id, turn); this.prompts.delete(agent.id)
+    // Redact before truncation so a private block crossing 2000 chars stays private.
+    const text = redactPrivateTags(textBlocks(input.content)).trim()
+    if (text.length <= 10) return
+    const content = text.slice(0, 2000)
+    this.runtime.queue.enqueue(agent.id, async () => {
+      const project = await this.runtime.prepare(agent)
+      const state = await this.runtime.sessions.register(agent.id, project)
+      if (this.turns.get(agent.id) === turn) this.prompts.set(agent.id, { turn, content, project: project.project, effectiveId: state.effectiveId })
+      await this.runtime.client.request('/prompts', { method: 'POST', body: {
+        session_id: state.effectiveId, content, project: project.project, project_provenance: project.provenance,
+      } })
+    })
+  }
+  result(exec: { name: string; parent?: unknown; agent?: Agent }, result: { isError?: boolean; content?: unknown }, ownTools: ReadonlySet<string>): void {
+    if (ownTools.has(exec.name) || exec.parent != null || result.isError || !exec.agent || isSubagent(exec.agent)) return
+    const content = redactPrivateTags(textBlocks(result.content))
+    if (content.length <= 50) return
+    const agent = exec.agent
+    this.runtime.queue.enqueue(agent.id, async () => {
+      const project = await this.runtime.prepare(agent)
+      const state = await this.runtime.sessions.register(agent.id, project)
+      await this.runtime.client.request('/observations/passive', { method: 'POST', body: {
+        session_id: state.effectiveId, content, project: project.project, source: exec.name, project_provenance: project.provenance,
+      } })
+    })
+  }
+  current(id: string, project: string, effectiveId: string): string | undefined {
+    const prompt = this.prompts.get(id)
+    return prompt && prompt.turn === this.turns.get(id) && prompt.project === project && prompt.effectiveId === effectiveId ? prompt.content : undefined
+  }
+  endTurn(id: string): void { this.turns.delete(id); this.prompts.delete(id) }
+  close(): void { this.turns.clear(); this.prompts.clear() }
+}
diff --git a/plugin/dsh/lib/client.ts b/plugin/dsh/lib/client.ts
new file mode 100644
index 0000000..19fa575
--- /dev/null
+++ b/plugin/dsh/lib/client.ts
@@ -0,0 +1,96 @@
+import { setTimeout as delay } from 'node:timers/promises'
+import type { Config } from './config.ts'
+import { redactUrlPath, redactValue } from './redaction.ts'
+
+export class EngramHttpError extends Error {
+  readonly status: number
+  readonly code: string | undefined
+  readonly data: unknown
+  constructor(status: number, data: unknown) {
+    const body = data as { error?: unknown; code?: unknown } | null
+    super(typeof body?.error === 'string' ? body.error : `Engram request failed with HTTP ${status}`)
+    this.name = 'EngramHttpError'; this.status = status; this.data = data
+    this.code = typeof body?.code === 'string' ? body.code : undefined
+  }
+}
+export class EngramUnavailableError extends Error {
+  constructor() { super('Engram connection refused. Start Engram or verify ENGRAM_URL/ENGRAM_BIN.'); this.name = 'EngramUnavailableError' }
+}
+export class EngramUnknownOutcomeError extends Error {
+  constructor() {
+    super('Engram write outcome is unknown; it may already have been saved. Use mem_search to verify before retrying. 可能已经写入，先用 mem_search 核实，不要直接重试。')
+    this.name = 'EngramUnknownOutcomeError'
+  }
+}
+export function hasErrorCode(error: unknown, code: string, depth = 0): boolean {
+  if (!error || typeof error !== 'object' || depth > 5) return false
+  const item = error as { code?: unknown; cause?: unknown; errors?: unknown[] }
+  return item.code === code || hasErrorCode(item.cause, code, depth + 1) || (Array.isArray(item.errors) && item.errors.some(e => hasErrorCode(e, code, depth + 1)))
+}
+export function fetchPolicy(path: string, method: string) {
+  if (method === 'POST' && path === '/sessions') return { timeoutMs: 5000, maxAttempts: 2, write: true }
+  if (method === 'GET') return { timeoutMs: path.startsWith('/doctor') ? 15000 : 10000, maxAttempts: 3, write: false }
+  return { timeoutMs: 3000, maxAttempts: 1, write: true }
+}
+export interface RequestOptions { method?: string; body?: unknown; signal?: AbortSignal; beforeDispatch?: (signal?: AbortSignal) => Promise<void> }
+export interface ClientOptions {
+  timeoutMs?: number
+  backoffMs?: number
+  fetch?: typeof fetch
+}
+export class Client {
+  readonly url: string
+  readonly token: string
+  binding?: () => unknown
+  beforeDispatch?: (signal?: AbortSignal) => Promise<void>
+  onUnavailable?: () => void
+  readonly options: ClientOptions
+  constructor(config: Config, options: ClientOptions = {}) {
+    this.url = config.url ?? `http://127.0.0.1:${config.port}`
+    this.token = config.token; this.options = options
+  }
+  headers(path: string): Record<string, string> {
+    return { 'Content-Type': 'application/json', ...(path !== '/health' && this.token ? { Authorization: `Bearer ${this.token}` } : {}) }
+  }
+  async request<T = unknown>(path: string, opts: RequestOptions = {}): Promise<T> {
+    const method = opts.method ?? 'GET', policy = fetchPolicy(path, method)
+    let ambiguous = false
+    for (let attempt = 0; attempt < policy.maxAttempts; attempt++) {
+      opts.signal?.throwIfAborted()
+      await this.beforeDispatch?.(opts.signal)
+      await opts.beforeDispatch?.(opts.signal)
+      // Qualification failures are never transport failures and must not be retried here.
+      let response: Response | undefined
+      try {
+        const timeout = AbortSignal.timeout(this.options.timeoutMs ?? policy.timeoutMs)
+        response = await (this.options.fetch ?? fetch)(`${this.url}${redactUrlPath(path)}`, {
+          method, headers: this.headers(path), body: opts.body === undefined ? undefined : JSON.stringify(redactValue(opts.body)),
+          signal: opts.signal ? AbortSignal.any([timeout, opts.signal]) : timeout,
+        })
+        const data = response.status === 204 ? null : await response.json()
+        if (!response.ok) throw new EngramHttpError(response.status, data)
+        return data as T
+      } catch (error) {
+        if (error instanceof EngramHttpError) throw error
+        if (response && !response.ok) throw new EngramHttpError(response.status, null)
+        // A cancelled dispatched write may still have committed; never replay it.
+        if (opts.signal?.aborted) {
+          if (policy.write) throw new EngramUnknownOutcomeError()
+          opts.signal.throwIfAborted()
+        }
+        const refused = hasErrorCode(error, 'ECONNREFUSED')
+        if (error instanceof SyntaxError && !policy.write) throw error
+        const preDispatch = ['ENOTFOUND', 'EAI_AGAIN', 'ENETUNREACH', 'EHOSTUNREACH', 'UND_ERR_CONNECT_TIMEOUT', 'ERR_INVALID_URL'].some(code => hasErrorCode(error, code))
+        ambiguous ||= !refused && !preDispatch
+        if (attempt + 1 === policy.maxAttempts) {
+          if (policy.write && ambiguous) throw new EngramUnknownOutcomeError()
+          if (refused) { this.onUnavailable?.(); throw new EngramUnavailableError() }
+          throw new Error('Engram request failed or timed out')
+        }
+        try { await delay((this.options.backoffMs ?? 250) * 2 ** attempt, undefined, { signal: opts.signal }) }
+        catch (error) { opts.signal?.throwIfAborted(); throw error }
+      }
+    }
+    throw new Error('Engram request exhausted attempts')
+  }
+}
diff --git a/plugin/dsh/lib/compaction.ts b/plugin/dsh/lib/compaction.ts
new file mode 100644
index 0000000..e3d86b7
--- /dev/null
+++ b/plugin/dsh/lib/compaction.ts
@@ -0,0 +1,67 @@
+import type { Runtime } from './runtime.ts'
+import type { Agent } from './project.ts'
+import { textBlocks } from './capture.ts'
+import { redactPrivateTags } from './redaction.ts'
+import { EngramUnknownOutcomeError } from './client.ts'
+
+export type ArchiveOutcome = 'confirmed' | 'unknown' | 'failed' | 'unavailable'
+// Adapted from Pi compaction-recovery.js. Static notices intentionally contain
+// neither user summary/context nor project names: strict context interpolation
+// must never interpret user-provided double braces.
+const notices: Record<ArchiveOutcome, string> = {
+  confirmed: 'Compaction recovery summary was already saved to Engram by engram-dsh. No manual mem_session_summary call is needed for this compaction. Call mem_context if you need additional recent project memory.',
+  unknown: 'Compaction recovery could not confirm whether the summary was saved to Engram. Do NOT retry or call mem_session_summary yet, because that could duplicate the summary. First verify with mem_search or mem_doctor; save the summary once only if it is absent.',
+  failed: 'CRITICAL INSTRUCTION FOR COMPACTED SUMMARY:\nThe agent has access to Engram persistent memory via native DSH tools when engram-dsh is active. FIRST ACTION REQUIRED: Call mem_session_summary with the content of this compacted summary for the verified current project. This preserves what was accomplished before compaction. Do this BEFORE any other work. If mem_session_summary is unavailable, manually save this compacted summary once Engram tools are available.',
+  unavailable: 'CRITICAL INSTRUCTION FOR COMPACTED SUMMARY:\nengram-dsh could not safely confirm the runtime session and project, so it did not archive the summary. Before saving manually, verify the active Engram session and project with mem_current_project or mem_doctor. Save the summary once only after that verification.',
+}
+export function recoveryNotice(outcome: ArchiveOutcome): string { return notices[outcome] }
+export class Compaction {
+  private runtime: Runtime
+  private seen = new Set<string>()
+  private generations = new Map<string, object>()
+  private pending = new Map<string, { text: string; delivered: boolean }>()
+  constructor(runtime: Runtime) { this.runtime = runtime }
+  event(session: Agent['session'] & { id: string }, event: unknown): void {
+    const input = event as { type?: string; data?: { compactionId?: unknown; summary?: unknown } } | null
+    if (input?.type !== 'compaction/summary' || typeof input.data?.compactionId !== 'string' || !input.data.compactionId) return
+    const summary = redactPrivateTags(textBlocks(input.data.summary)).trim()
+    if (!summary) return
+    const key = `${session.id}\0${input.data.compactionId}`
+    if (this.seen.has(key)) return
+    this.seen.add(key)
+    if (this.seen.size > 256) this.seen.delete(this.seen.values().next().value!)
+    const generation = this.generations.get(session.id) ?? {}
+    this.generations.set(session.id, generation)
+    const agent = { id: session.id, session }
+    this.runtime.queue.enqueue(session.id, async () => {
+      let outcome: ArchiveOutcome = 'unavailable'
+      try {
+        const project = await this.runtime.prepare(agent)
+        await this.runtime.sessions.register(agent.id, project)
+        try {
+          const receipt = await this.runtime.sessions.write(agent.id, project, {
+            type: 'session_summary', title: 'Compaction recovery summary', content: summary,
+            scope: 'project', topic_key: 'session/compaction-recovery',
+          }) as { id?: unknown; status?: unknown } | null
+          outcome = receipt && Number.isSafeInteger(receipt.id) && Number(receipt.id) > 0 && receipt.status === 'saved' ? 'confirmed' : 'unknown'
+        } catch (error) {
+          outcome = error instanceof EngramUnknownOutcomeError ? 'unknown' : 'failed'
+          this.runtime.report(`Engram compaction archive ${outcome}`, error)
+        }
+      } catch (error) { this.runtime.report('Engram compaction unavailable', error) }
+      if (this.generations.get(session.id) === generation) this.pending.set(session.id, { text: recoveryNotice(outcome), delivered: false })
+    })
+  }
+  notice(id: string | undefined): string {
+    const entry = id ? this.pending.get(id) : undefined
+    if (!entry) return ''
+    entry.delivered = true
+    return entry.text
+  }
+  clearDelivered(id: string): void { if (this.pending.get(id)?.delivered) this.pending.delete(id) }
+  dispose(id: string): void {
+    this.generations.delete(id); this.pending.delete(id)
+    for (const key of this.seen) if (key.startsWith(`${id}\0`)) this.seen.delete(key)
+  }
+  close(): void { this.seen.clear(); this.pending.clear(); this.generations.clear() }
+}
diff --git a/plugin/dsh/lib/config.ts b/plugin/dsh/lib/config.ts
new file mode 100644
