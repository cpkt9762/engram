+  assert.deepEqual(h.seen.at(-1).data, { content: 'new' })
+  await assert.rejects(h.tools.mem_update.execute({ ...base, find: '', replace: 'y' }, h.exec), e => e instanceof EngramHttpError && e.message === 'at least one field is required')
