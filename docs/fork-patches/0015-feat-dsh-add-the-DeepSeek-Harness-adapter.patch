+  await assert.rejects(h.tools.mem_save.execute({ title: 'x', content: 'body', project: 'other' }, h.exec), e => e instanceof EngramHttpError && e.status === 409 && e.code === 'session_isolation_conflict')
+  for (const ack of ['unrelated', 'a@other:resume:', 'a@other:resume:0']) {
+    const bad = await harness(t, { ack })
+    await assert.rejects(bad.tools.mem_save.execute({ title: 'x', content: 'body', project: 'other' }, bad.exec), /acknowledgement/)
+    assert.equal(bad.writes.length, 0)
+  }
+})
+test('resumed satellite receipts, 60-second renewal and prompt/summary/finalize attribution', async t => {
+  const h = await harness(t, { ack: 'a@other:resume:3' })
+  await h.tools.mem_save_prompt.execute({ content: 'prompt', project: 'other' }, h.exec)
+  assert.equal(h.writes.at(-1).session_id, 'a@other:resume:3')
+  await h.tools.mem_session_summary.execute({ content: 'summary', project: 'other' }, h.exec)
+  assert.equal(h.registrations.length, 1)
+  h.advance()
+  await h.tools.mem_session_summary.execute({ content: 'renewed', project: 'other' }, h.exec)
+  assert.equal(h.registrations.length, 2)
+  const result = await h.tools.mem_session_finalize.execute({ summary: 'summary', project: 'other' }, h.exec)
+  assert.equal(result.session_id, 'a@other:resume:3')
+})
+test('root end precedes satellite ends; partial failure reports root fact and can retry cleanup', async t => {
+  const h = await harness(t)
+  await h.tools.mem_save.execute({ title: 'other', content: 'body', project: 'other' }, h.exec)
+  await h.tools.mem_save.execute({ title: 'root', content: 'body' }, h.exec)
+  h.failEnd(true)
+  await assert.rejects(h.tools.mem_session_end.execute({}, h.exec), e => e instanceof SatelliteEndError && e.rootEnded === true && /other.*end rejected/.test(e.message))
+  assert.deepEqual(h.ends, ['a', 'a@other'])
+  assert.equal(h.runtime.sessions.states.size, 0)
+  h.failEnd(false)
+  await h.tools.mem_session_end.execute({}, h.exec)
+  assert.deepEqual(h.ends, ['a', 'a@other', 'a@other'])
+  assert.equal(h.runtime.sessions.states.size, 0)
+})
diff --git a/plugin/dsh/test/save-recovery.test.mjs b/plugin/dsh/test/save-recovery.test.mjs
new file mode 100644
index 0000000..894b551
--- /dev/null
+++ b/plugin/dsh/test/save-recovery.test.mjs
@@ -0,0 +1,93 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { stub, json, config, body } from './helpers.test.mjs'
+import { Client, EngramHttpError, EngramUnknownOutcomeError } from '../lib/client.ts'
+import { postObservationWithReplayRecovery } from '../lib/save-recovery.ts'
+const miss = { code: 'observation_save_result_not_found', error: 'no committed result found for operation_id' }
+
+test('lost acknowledgement resolves from authoritative ledger without replay', async t => {
+  let posts = 0, guards = 0, operation
+  const { url } = await stub(t, async (req, res) => {
+    if (req.method === 'POST') { posts++; operation = (await body(req)).operation_id; req.socket.destroy() }
+    else { assert.equal(new URL(req.url, 'http://local').searchParams.get('operation_id'), operation); json(res, { id: 7, status: 'committed' }) }
+  })
+  const client = new Client(config(url)); client.beforeDispatch = async () => { guards++ }
+  assert.deepEqual(await postObservationWithReplayRecovery(client, { title: 'x' }), { id: 7, status: 'committed' })
+  assert.equal(posts, 1); assert.equal(guards, 3)
+})
+test('typed miss permits exactly one identical redacted replay', async t => {
+  const payload = { title: 'original', content: '<private>secret</private> public' }, bytes = [], methods = []
+  const { url } = await stub(t, async (req, res) => {
+    methods.push(req.method)
+    if (req.method === 'GET') return json(res, miss, 404)
+    let raw = ''; for await (const chunk of req) raw += chunk
+    bytes.push(raw)
+    if (bytes.length === 1) { payload.title = 'mutated'; req.socket.destroy() }
+    else json(res, { id: 8, status: 'saved' }, 201)
+  })
+  assert.deepEqual(await postObservationWithReplayRecovery(new Client(config(url)), payload, undefined, { backoffMs: 1 }), { id: 8, status: 'saved' })
+  assert.deepEqual(methods, ['POST', 'GET', 'POST']); assert.equal(bytes[0], bytes[1])
+  assert.equal(JSON.parse(bytes[0]).title, 'original'); assert.ok(!bytes[0].includes('secret'))
+})
+for (const status of [409, 410]) test(`replay HTTP ${status} gets one final authoritative lookup`, async t => {
+  let posts = 0, gets = 0
+  const { url } = await stub(t, async (req, res) => {
+    if (req.method === 'POST') { await body(req); posts++; if (posts === 1) req.socket.destroy(); else json(res, { error: 'ledger ambiguity' }, status) }
+    else { gets++; json(res, gets === 1 ? miss : { id: 9, status: 'committed' }, gets === 1 ? 404 : 200) }
+  })
+  assert.equal((await postObservationWithReplayRecovery(new Client(config(url)), {}, undefined, { backoffMs: 1 })).id, 9)
+  assert.equal(posts, 2); assert.equal(gets, 2)
+})
+test('unresolved recovery remains unknown and does not expose UUID in errors or logs', async t => {
+  let posts = 0, gets = 0, operation
+  const { url } = await stub(t, async (req, res) => {
+    if (req.method === 'POST') { operation = (await body(req)).operation_id; posts++; req.socket.destroy() }
+    else { gets++; if (gets === 1) json(res, miss, 404); else req.socket.destroy() }
+  })
+  let failure
+  try { await postObservationWithReplayRecovery(new Client(config(url)), {}, undefined, { backoffMs: 1 }) } catch (error) { failure = error }
+  assert.ok(failure instanceof EngramUnknownOutcomeError)
+  assert.ok(!failure.message.includes(operation))
+  const { Diagnostics } = await import('../lib/diagnostics.ts'), logs = []
+  new Diagnostics({ error: (...args) => logs.push(args), warn: (...args) => logs.push(args) }, '').report('save', failure)
+  assert.ok(!JSON.stringify(logs).includes(operation)); assert.equal(posts, 2); assert.equal(gets, 2)
+})
+test('first HTTP failure stays typed and never replays or leaks echoed UUID', async t => {
+  let requests = 0, operation
+  const { url } = await stub(t, async (req, res) => {
+    requests++; operation = (await body(req)).operation_id
+    json(res, { error: `rejected ${operation}`, code: 'invalid_arguments' }, 400)
+  })
+  await assert.rejects(postObservationWithReplayRecovery(new Client(config(url)), {}), e => e instanceof EngramHttpError && e.status === 400 && e.code === 'invalid_arguments' && !e.message.includes(operation) && !JSON.stringify(e.data).includes(operation))
+  assert.equal(requests, 1)
+})
+test('untyped misses and noncommitted lookup receipts never authorize replay or success', async t => {
+  for (const response of [{ status: 404, data: { error: 'not found' } }, { status: 200, data: { id: 1, status: 'saved' } }]) {
+    let posts = 0
+    const { url } = await stub(t, (req, res) => { if (req.method === 'POST') { posts++; req.socket.destroy() } else json(res, response.data, response.status) })
+    await assert.rejects(postObservationWithReplayRecovery(new Client(config(url)), {}), EngramUnknownOutcomeError)
+    assert.equal(posts, 1)
+  }
+})
+test('caller cancellation before dispatch, during exchange and during backoff is propagated', async t => {
+  const pre = new AbortController(); pre.abort(new Error('before save'))
+  await assert.rejects(postObservationWithReplayRecovery(new Client(config('http://127.0.0.1:1')), {}, pre.signal), /before save/)
+  for (const backoff of [false, true]) {
+    const controller = new AbortController(); let posts = 0
+    const { url } = await stub(t, async (req, res) => {
+      if (req.method === 'POST') { posts++; await body(req); if (!backoff) controller.abort(new Error('cancel exchange')); else req.socket.destroy() }
+      else { json(res, miss, 404); setTimeout(() => controller.abort(new Error('cancel backoff')), 10) }
+    })
+    await assert.rejects(postObservationWithReplayRecovery(new Client(config(url)), {}, controller.signal), backoff ? /cancel backoff/ : /cancel exchange/)
+    assert.equal(posts, 1)
+  }
+})
+test('total deadline is bounded and qualification or binding changes block recovery dispatch', async t => {
+  const { url } = await stub(t, () => {})
+  await assert.rejects(postObservationWithReplayRecovery(new Client(config(url)), {}, undefined, { totalMs: 50, postMs: 20, getMs: 20 }), EngramUnknownOutcomeError)
+  let identity = 'a', posts = 0, gets = 0
+  const other = await stub(t, (req, res) => { if (req.method === 'POST') { posts++; identity = 'b'; req.socket.destroy() } else { gets++; json(res, { id: 3, status: 'committed' }) } })
+  const client = new Client(config(other.url)); client.binding = () => identity
+  await assert.rejects(postObservationWithReplayRecovery(client, {}), EngramUnknownOutcomeError)
+  assert.equal(posts, 1); assert.equal(gets, 0)
+})
diff --git a/plugin/dsh/test/server.test.mjs b/plugin/dsh/test/server.test.mjs
new file mode 100644
index 0000000..e482130
--- /dev/null
+++ b/plugin/dsh/test/server.test.mjs
@@ -0,0 +1,105 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { writeFile, readFile, mkdtemp } from 'node:fs/promises'
+import { join } from 'node:path'
+import { stub, json, config, identity, home, contract } from './helpers.test.mjs'
+import { Server, ownership, startupBackoffMs } from '../lib/server.ts'
+
+async function binary() {
+  const dir = await mkdtemp(join(home, 'bin-')), file = join(dir, 'engram'), record = join(dir, 'calls')
+  await writeFile(file, `#!${process.execPath}
+const fs = require('node:fs'), http = require('node:http');
+fs.appendFileSync(${JSON.stringify(record)}, JSON.stringify({args:process.argv.slice(2),port:process.env.ENGRAM_PORT})+'\\n');
+if(process.argv[2]==='instance-id') { console.log('${identity}'); }
+else {
+ const server=http.createServer((req,res)=>{res.end(JSON.stringify(req.url==='/health'?{instance_id:'${identity}'}:req.url==='/runtime-contract'?${JSON.stringify(contract())}:{project:'recovery'})); setTimeout(()=>server.close(),500).unref();});
+ server.listen(Number(process.env.ENGRAM_PORT),'127.0.0.1');
+ setTimeout(()=>server.close(),2000).unref();
+}
+`, { mode: 0o700 })
+  return { file, calls: async () => (await readFile(record, 'utf8')).trim().split('\n').map(JSON.parse) }
+}
+test('explicit URL never resolves identity or launches a binary', async () => {
+  await new Server(config('http://127.0.0.1:1')).ensure()
+})
+test('ownership distinguishes ready, foreign, legacy and missing identity', () => {
+  assert.equal(ownership({ instance_id: identity }, identity), 'ready')
+  assert.equal(ownership({ instance_id: 'b'.repeat(32) }, identity), 'foreign')
+  for (const version of ['1.9.0', '2.0.0-rc.10', '2.0.0-alpha.1']) assert.equal(ownership({ version }, identity), 'legacy')
+  for (const version of [undefined, 'unknown', '2.0.0', '2.0.0-rc.11', '2.0.0-rc.01', '3.0.0']) assert.equal(ownership({ version }, identity), 'identity_missing')
+})
+for (const [state, health] of [['ready', { instance_id: identity }], ['foreign', { instance_id: 'b'.repeat(32) }], ['legacy', { version: '1.0.0' }], ['identity_missing', {}]]) {
+  test(`implicit server ${state}: never adopts or spawns over existing service`, async t => {
+    const { url } = await stub(t, (req, res) => json(res, health))
+    const bin = await binary()
+    const server = new Server({ ...config(undefined), port: Number(new URL(url).port), engramBin: bin.file })
+    if (state === 'ready') await server.ensure()
+    else await assert.rejects(server.ensure(), new RegExp(state))
+    assert.deepEqual((await bin.calls()).map(c => c.args), [['instance-id']])
+  })
+}
+test('only refused connection spawns serve with configured ENGRAM_PORT', async t => {
+  const { url, server: placeholder } = await stub(t, () => {})
+  const port = Number(new URL(url).port)
+  await new Promise(resolve => placeholder.close(resolve))
+  const bin = await binary()
+  const server = new Server({ ...config(undefined), port, engramBin: bin.file })
+  await Promise.all([server.ensure(), server.ensure()])
+  const calls = await bin.calls()
+  assert.deepEqual(calls.map(c => c.args), [['instance-id'], ['serve']])
+  assert.equal(calls[1].port, String(port))
+})
+test('non-refused health failure never spawns and startup failure is single-flight with backoff', async t => {
+  let requests = 0, now = 0
+  const { url } = await stub(t, (req, res) => { requests++; json(res, {}, 503) })
+  const bin = await binary()
+  const server = new Server({ ...config(undefined), port: Number(new URL(url).port), engramBin: bin.file }, () => now)
+  await Promise.all([assert.rejects(server.ensure()), assert.rejects(server.ensure())])
+  await assert.rejects(server.ensure())
+  assert.equal(requests, 1)
+  now = 1001; await assert.rejects(server.ensure())
+  assert.equal(requests, 2)
+  assert.equal((await bin.calls()).length, 2)
+  assert.deepEqual([1, 2, 8].map(startupBackoffMs), [1000, 2000, 60000])
+})
+test('missing binary and malformed identity fail before connecting', async () => {
+  await assert.rejects(new Server(config(undefined)).ensure(), /instance-id failed/)
+  const path = join(home, 'bad-engram')
+  await writeFile(path, '#!/bin/sh\nprintf "invalid\\n"\n', { mode: 0o700 })
+  await assert.rejects(new Server({ ...config(undefined), engramBin: path }).ensure(), /32 hexadecimal/)
+})
+test('runtime recovers a stopped implicit serve on next call without replaying this call', async t => {
+  const { Runtime } = await import('../lib/runtime.ts')
+  const { contract, agent } = await import('./helpers.test.mjs')
+  const { EngramUnavailableError } = await import('../lib/client.ts')
+  const { url, server: initial } = await stub(t, (req, res) => {
+    res.setHeader('Connection', 'close')
+    json(res, req.url === '/health' ? { instance_id: identity } : req.url === '/runtime-contract' ? contract() : { project: 'recovery' })
+  })
+  const port = Number(new URL(url).port)
+  const bin = await binary()
+  const runtime = new Runtime({ ...config(undefined), port, engramBin: bin.file })
+  await runtime.prepare(agent())
+  await new Promise(resolve => { initial.closeAllConnections(); initial.close(resolve) })
+  await assert.rejects(runtime.prepare(agent()), EngramUnavailableError)
+  assert.equal((await bin.calls()).length, 1)
+  assert.equal((await runtime.prepare(agent())).project, 'recovery')
+  const calls = await bin.calls()
+  assert.deepEqual(calls.map(c => c.args), [['instance-id'], ['instance-id'], ['serve']])
+  assert.equal(calls.at(-1).port, String(port))
+})
+test('explicit URL stays unavailable without executing its configured binary', async t => {
+  const { Runtime } = await import('../lib/runtime.ts')
+  const { contract, agent } = await import('./helpers.test.mjs')
+  const { EngramUnavailableError } = await import('../lib/client.ts')
+  const { url, server: initial } = await stub(t, (req, res) => {
+    res.setHeader('Connection', 'close')
+    json(res, req.url === '/runtime-contract' ? contract() : { project: 'remote' })
+  })
+  const runtime = new Runtime(config(url))
+  await runtime.prepare(agent())
+  await new Promise(resolve => { initial.closeAllConnections(); initial.close(resolve) })
+  await assert.rejects(runtime.prepare(agent()), EngramUnavailableError)
+  await assert.rejects(runtime.prepare(agent()), EngramUnavailableError)
+  assert.equal(runtime.server.localId, undefined)
+})
diff --git a/plugin/dsh/test/session.test.mjs b/plugin/dsh/test/session.test.mjs
new file mode 100644
index 0000000..ca9d5bb
--- /dev/null
+++ b/plugin/dsh/test/session.test.mjs
@@ -0,0 +1,140 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { stub, json, config, body, home } from './helpers.test.mjs'
+import { Client, EngramUnknownOutcomeError } from '../lib/client.ts'
+import { Sessions, SessionProjectConflictError } from '../lib/session.ts'
+const project = { cwd: home, project: 'p', provenance: { source: 'config', directory: home }, response: {} }
+
+test('lazy registration adopts server resume id and caches until 60 seconds; invalidate re-registers', async t => {
+  let registrations = 0, now = 0; const writes = []
+  const { url } = await stub(t, async (req, res) => {
+    if (req.url === '/health') return json(res, { capabilities: { root_session_resume: true } })
+    const data = await body(req)
+    if (req.url === '/sessions') {
+      registrations++; assert.equal(data.resume, true); assert.equal(data.ownership_mode, 'project_owned')
+      assert.deepEqual(data.project_provenance, project.provenance)
+      return json(res, { id: `${data.id}:resume:${registrations}`, status: 'created' }, 201)
+    }
+    writes.push(data); json(res, { id: writes.length }, 201)
+  })
+  const sessions = new Sessions(new Client(config(url)), () => now)
+  assert.equal(registrations, 0)
+  await Promise.all([sessions.register('a', project), sessions.register('a', project)])
+  await sessions.write('a', project, { title: 'first' })
+  assert.equal(writes[0].session_id, 'a:resume:1'); assert.equal(registrations, 1)
+  now = 60000; await sessions.write('a', project, {}); assert.equal(registrations, 1)
+  now = 60001; await sessions.write('a', project, {}); assert.equal(writes.at(-1).session_id, 'a:resume:2')
+  sessions.invalidate('a'); assert.equal(sessions.states.has('a'), false)
+  await sessions.write('a', project, {}); assert.equal(registrations, 3)
+  sessions.dispose('a'); assert.equal(sessions.states.has('a'), false)
+})
+test('missing resume capability blocks registration and writes', async t => {
+  let calls = 0
+  const { url } = await stub(t, (req, res) => { calls++; json(res, {}) })
+  await assert.rejects(new Sessions(new Client(config(url))).write('a', project, {}), /root_session_resume/)
+  assert.equal(calls, 1)
+})
+test('409 session_project_conflict is typed and no write follows', async t => {
+  let writes = 0
+  const { url } = await stub(t, (req, res) => {
+    if (req.url === '/health') json(res, { capabilities: { root_session_resume: true } })
+    else if (req.url === '/sessions') json(res, { code: 'session_project_conflict' }, 409)
+    else { writes++; json(res, {}) }
+  })
+  await assert.rejects(new Sessions(new Client(config(url))).write('a', project, {}), SessionProjectConflictError)
+  assert.equal(writes, 0)
+})
+for (const id of ['other', 'a:resume:', 'a:resume:0', 'a:resume:1garbage']) {
+  test(`registration rejects invalid effective id ${id}`, async t => {
+    const { url } = await stub(t, (req, res) => json(res, req.url === '/health' ? { capabilities: { root_session_resume: true } } : { id, status: 'created' }))
+    await assert.rejects(new Sessions(new Client(config(url))).register('a', project), /acknowledgement/)
+  })
+}
+test('unknown write outcome never re-registers or resends', async t => {
+  let registrations = 0, writes = 0
+  const { url } = await stub(t, async (req, res) => {
+    if (req.url === '/health') return json(res, { capabilities: { root_session_resume: true } })
+    if (req.url === '/sessions') { registrations++; return json(res, { id: 'a', status: 'created' }) }
+    writes++; req.socket.destroy()
+  })
+  await assert.rejects(new Sessions(new Client(config(url))).write('a', project, {}), EngramUnknownOutcomeError)
+  assert.equal(registrations, 1); assert.equal(writes, 1)
+})
+test('one agent cannot change project or cwd using cached registration', async t => {
+  const { url } = await stub(t, (req, res) => json(res, req.url === '/health' ? { capabilities: { root_session_resume: true } } : { id: 'a', status: 'created' }))
+  const sessions = new Sessions(new Client(config(url)))
+  await sessions.register('a', project)
+  await assert.rejects(sessions.register('a', { ...project, project: 'q' }), SessionProjectConflictError)
+  await assert.rejects(sessions.register('a', { ...project, cwd: '/different' }), SessionProjectConflictError)
+})
+test('invalidate during registration prevents stale acknowledgement repopulating state', async t => {
+  let release, started
+  const arrived = new Promise(resolve => { started = resolve })
+  const gate = new Promise(resolve => { release = resolve })
+  const { url } = await stub(t, async (req, res) => {
+    if (req.url === '/health') return json(res, { capabilities: { root_session_resume: true } })
+    started(); await gate; json(res, { id: 'a', status: 'created' })
+  })
+  const sessions = new Sessions(new Client(config(url)))
+  const pending = sessions.register('a', project)
+  await arrived
+  sessions.invalidate('a'); release()
+  await assert.rejects(pending, /invalidated/)
+  assert.equal(sessions.states.has('a'), false)
+})
+test('session close succeeds once, invalidates state, and uses the confirmed effective id', async t => {
+  const seen = []
+  const { url } = await stub(t, async (req, res) => {
+    if (req.url === '/health') return json(res, { capabilities: { root_session_resume: true } })
+    const data = await body(req); seen.push([req.url, data])
+    if (req.url === '/sessions') return json(res, { id: 'a:resume:9', status: 'created' })
+    assert.equal(req.url, '/sessions/a%3Aresume%3A9/end')
+    json(res, { id: 'a:resume:9', status: 'completed' })
+  })
+  const sessions = new Sessions(new Client(config(url)))
+  await sessions.end('a', project, 'done')
+  assert.equal(sessions.states.has('a'), false)
+  assert.deepEqual(seen.at(-1)[1], { summary: 'done', project_provenance: project.provenance })
+})
+test('unknown session end stays pinned until explicit retry and never automatically resends', async t => {
+  let closes = 0, registrations = 0
+  const { url } = await stub(t, async (req, res) => {
+    if (req.url === '/health') return json(res, { capabilities: { root_session_resume: true } })
+    await body(req)
+    if (req.url === '/sessions') { registrations++; return json(res, { id: 'a', status: 'created' }) }
+    closes++
+    if (closes === 1) req.socket.destroy()
+    else json(res, { id: 'a', status: 'completed' })
+  })
+  const sessions = new Sessions(new Client(config(url)))
+  await assert.rejects(sessions.end('a', project), EngramUnknownOutcomeError)
+  assert.equal(closes, 1)
+  await assert.rejects(sessions.write('a', project, {}), /closing/)
+  await sessions.end('a', project)
+  assert.equal(closes, 2); assert.equal(registrations, 1)
+})
+test('confirmed finalization invalidates identity and allows registering a continuation', async t => {
+  let registrations = 0
+  const { url } = await stub(t, async (req, res) => {
+    if (req.url === '/health') return json(res, { capabilities: { root_session_resume: true } })
+    await body(req)
+    if (req.url === '/sessions') { registrations++; return json(res, { id: registrations === 1 ? 'a' : 'a:resume:2', status: 'created' }) }
+    if (req.url.endsWith('/finalize')) return json(res, { session_id: 'a', state: 'finalized', summary_id: 1, summary_sync_id: 'obs-1', already_finalized: false })
+    json(res, { id: 2, status: 'saved' })
+  })
+  const sessions = new Sessions(new Client(config(url)))
+  await sessions.finalize('a', project, 'summary')
+  assert.equal(sessions.states.has('a'), false)
+  await sessions.write('a', project, {})
+  assert.equal(sessions.states.get('a').effectiveId, 'a:resume:2')
+  assert.equal(registrations, 2)
+})
+test('malformed finalization acknowledgement remains unknown and blocks new writes', async t => {
+  const { url } = await stub(t, (req, res) => json(res,
+    req.url === '/health' ? { capabilities: { root_session_resume: true } }
+      : req.url === '/sessions' ? { id: 'a', status: 'created' }
+        : { state: 'finalized', session_id: 'other', summary_id: 1, summary_sync_id: 'obs-1', already_finalized: false }))
+  const sessions = new Sessions(new Client(config(url)))
+  await assert.rejects(sessions.finalize('a', project, 'summary'), /outcome is unknown/)
+  await assert.rejects(sessions.write('a', project, {}), /closing or finalized/)
+})
diff --git a/plugin/dsh/test/tools.test.mjs b/plugin/dsh/test/tools.test.mjs
