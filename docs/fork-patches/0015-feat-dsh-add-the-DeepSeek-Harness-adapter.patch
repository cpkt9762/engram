--- /dev/null
+++ b/plugin/dsh/lib/doctor.ts
@@ -0,0 +1,21 @@
+// Safe diagnostic projection ported from Pi callerBindingProjection. This is
+// read-only evidence; no session registration or write-success guarantee.
+const nextSteps = [
+  'No action required; a later write is not guaranteed.',
+  'Collect caller context without registering a session.',
+  'Verify support and availability of the caller diagnostic.',
+  'Use the normal runtime registration path; diagnosis does not register sessions.',
+  'Inspect the runtime binding; diagnosis does not repair it.',
+  'Resume through a host that can persist effective identity; do not reopen the ended session.',
+]
+const reasons = ['caller_context_missing', 'caller_binding_unavailable', 'session_not_registered', 'effective_session_missing', 'session_project_conflict', 'effective_mapping_invalid', 'host_context_missing', 'resume_required', 'ended_session_without_persistence', 'binding_observed']
+export function callerProjection(value: unknown) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid Engram caller-binding assessment')
+  const data = value as Record<string, unknown>
+  if (!['ok', 'warning', 'blocked', 'unknown'].includes(String(data.status))
+    || !['active', 'ended', 'missing', 'unknown'].includes(String(data.root_state))
+    || !['active', 'ended', 'missing', 'unknown'].includes(String(data.effective_state))
+    || !reasons.includes(String(data.reason_code)) || !nextSteps.includes(String(data.safe_next_step))
+    || data.write_success_guaranteed !== false) throw new Error('Invalid Engram caller-binding assessment')
+  return { status: data.status, root_state: data.root_state, effective_state: data.effective_state, reason_code: data.reason_code, safe_next_step: data.safe_next_step, write_success_guaranteed: false }
+}
diff --git a/plugin/dsh/lib/project.ts b/plugin/dsh/lib/project.ts
new file mode 100644
index 0000000..3ef1f2d
--- /dev/null
+++ b/plugin/dsh/lib/project.ts
@@ -0,0 +1,83 @@
+import { readFile } from 'node:fs/promises'
+import { dirname, isAbsolute, join } from 'node:path'
+import { setTimeout as delay } from 'node:timers/promises'
+import { EngramHttpError } from './client.ts'
+import { ConfigurationError } from './diagnostics.ts'
+import type { Client } from './client.ts'
+
+export interface Agent { id: string; session: { header: { cwd?: string; origin?: string; delegationDepth?: number } } }
+export interface Provenance { source: string; directory: string; raw_project?: string }
+export interface Project { cwd: string; project: string; provenance: Provenance; response: Record<string, unknown> }
+export function agentCwd(agent: Agent): string {
+  const cwd = agent?.session?.header?.cwd
+  if (typeof cwd !== 'string' || !isAbsolute(cwd)) throw new Error('Agent session.header.cwd must be an absolute directory')
+  return cwd
+}
+async function localConfig(cwd: string): Promise<Record<string, unknown>> {
+  let current = cwd
+  for (;;) {
+    let text: string
+    try { text = await readFile(join(current, '.engram/config.json'), 'utf8') }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw new ConfigurationError('project', 'Could not read .engram/config.json', cwd + ':Could not read .engram/config.json')
+      const parent = dirname(current)
+      if (parent === current) throw new ConfigurationError('project', 'Server lacks /project/current and no .engram/config.json was found', cwd + ':Server lacks /project/current and no .engram/config.json was found')
+      current = parent; continue
+    }
+    try {
+      const data = JSON.parse(text)
+      return { project: data.project_name, raw_project: data.project_name, project_source: 'config', cwd, project_path: current }
+    } catch { throw new ConfigurationError('project', 'Invalid .engram/config.json', cwd + ':Invalid .engram/config.json') }
+  }
+}
+export class Projects {
+  readonly client: Client
+  readonly now: () => number
+  private cache = new Map<string, { value?: Project; error?: Error; at: number }>()
+  private flights = new Map<string, Promise<Project>>()
+  constructor(client: Client, now = Date.now) { this.client = client; this.now = now }
+  async resolve(cwd: string, signal?: AbortSignal): Promise<Project> {
+    if (!isAbsolute(cwd)) throw new Error('Project cwd must be absolute')
+    signal?.throwIfAborted()
+    const cached = this.cache.get(cwd)
+    if (cached?.value) return cached.value
+    if (cached?.error && this.now() - cached.at < 30000) throw cached.error
+    // Caller cancellation is never shared between otherwise independent tool invocations.
+    if (!signal && this.flights.has(cwd)) return this.flights.get(cwd)!
+    const flight = this.detect(cwd, signal).then(value => {
+      this.cache.set(cwd, { value, at: this.now() }); return value
+    }, error => {
+      if (!signal?.aborted) this.cache.set(cwd, { error, at: this.now() })
+      throw error
+    })
+    if (!signal) this.flights.set(cwd, flight)
+    try { return await flight } finally { if (this.flights.get(cwd) === flight) this.flights.delete(cwd) }
+  }
+  private async detect(cwd: string, signal?: AbortSignal): Promise<Project> {
+    let last: unknown
+    for (let attempt = 0; attempt < 5; attempt++) {
+      let data: Record<string, unknown>
+      try { data = await this.client.request(`/project/current?cwd=${encodeURIComponent(cwd)}`, { signal }) }
+      catch (error) {
+        signal?.throwIfAborted()
+        if (error instanceof EngramHttpError && error.status === 404) data = await localConfig(cwd)
+        else if (error instanceof EngramHttpError && error.status === 409 && error.code === 'explicit_project_required') throw new ConfigurationError('project', 'Explicit project required; start DSH in a project directory', cwd + ':Explicit project required; start DSH in a project directory')
+        else {
+          // Contract failures must fail closed immediately, never use a config fallback.
+          if (error instanceof Error && error.name === 'RuntimeContractError') throw error
+          last = error
+          if (attempt < 4) await delay(200, undefined, { signal })
+          continue
+        }
+      }
+      const candidate = typeof data?.project === 'string' ? data.project.trim() : ''
+      if (!candidate || candidate.toLowerCase() === 'unknown' || data.error_hint !== undefined || /[\\/\x00-\x1f\x7f]/.test(candidate)) throw new ConfigurationError('project', 'Engram project resolution failed; check project configuration', cwd + ':Engram project resolution failed; check project configuration')
+      // Evidence only, ported from Pi captureProjectProvenance.
+      return { cwd, project: candidate, response: data, provenance: {
+        source: typeof data.project_source === 'string' ? data.project_source || 'unknown' : 'unknown', directory: cwd,
+        ...(typeof data.raw_project === 'string' ? { raw_project: data.raw_project } : {}),
+      } }
+    }
+    throw last instanceof Error ? last : new Error('Engram project resolution failed after five attempts')
+  }
+}
diff --git a/plugin/dsh/lib/protocol.ts b/plugin/dsh/lib/protocol.ts
new file mode 100644
index 0000000..032ddfd
--- /dev/null
+++ b/plugin/dsh/lib/protocol.ts
@@ -0,0 +1,98 @@
+// Memory prose adapted from plugin/pi/index.ts for the DSH host.
+const MEMORY_INSTRUCTIONS = `## Engram Persistent Memory — Protocol
+
+You have access to Engram, a persistent memory system that survives across sessions and compactions.
+The agent MUST follow this protocol without waiting for activation.
+These instructions are injected by engram-dsh, the native DSH memory provider. Use the memory tools named in this section as the authoritative DSH memory contract. Do not infer alternative Engram tool names from other integrations unless the user explicitly asks you to use them.
+
+### CANONICAL TOPIC WORKFLOW (mandatory — not optional)
+
+A memory is an evolving topic, not a log entry. Follow this workflow for every learning worth persisting.
+
+1. **SEARCH first.** Use \`mem_search\` on the bounded subject in the intended project and scope before writing.
+2. **READ in full.** Use \`mem_get_observation\` on plausible candidates; search snippets are not enough to decide identity.
+3. **SAME bounded topic?** Use \`mem_update\` by ID. Keep the existing \`topic_key\`, preserve every still-valid fact, and rewrite only what changed. Record superseded facts as history inside the content instead of leaving competing current truths.
+4. **Genuinely new topic?** Use \`mem_save\` with a deliberate, distinct \`topic_key\`. If the learning is already covered, write nothing.
+5. **Ambiguous identity or failed lookup?** Do not blindly overwrite and do not fall back to a duplicate save. A failed read is not evidence of absence.
+6. **Never merge across projects or scopes.** A matching suggested \`topic_key\` or a similar title is a hint, not proof of identity.
+
+Persist verified knowledge that is durable and costly to reconstruct: decisions with rationale,
+non-obvious root causes, real constraints, and resumption-relevant pending work.
+Group related conclusions deliberately, not every task, response, or event.
+Exclude secrets, private data, speculation, raw dumps, and routine progress.
+Never save credentials, private content, or personal data.
+
+Format for \`mem_save\`:
+- **title**: Verb + what — short, searchable
+- **type**: bugfix | decision | architecture | discovery | pattern | config | preference
+- **scope**: \`project\` (default) | \`personal\` | \`global\`
+- **topic_key**: stable, deliberate key for the topic; reuse via \`mem_update\` rather than duplicating
+- **content**:
+  **What**: One sentence — what was done
+  **Why**: What motivated it
+  **Where**: Files or paths affected
+  **Learned**: Gotchas, edge cases, things that surprised you
+
+Format for \`mem_update\`:
+- **id**: observation ID from \`mem_search\` / \`mem_get_observation\`
+- **expected_project**: project that owns the observation
+- **topic_key**: keep the existing key unless the topic itself changed
+- **content**: full rewritten content including every still-valid fact, with changed or superseded facts recorded as history
+
+### NATIVE SESSION ATTRIBUTION
+
+Native \`mem_save\`, \`mem_save_prompt\`, \`mem_session_summary\`, and \`mem_capture_passive\`
+derive attribution from the current DSH host session and confirmed Engram registration.
+Do not invent or override \`session_id\`; engram-dsh owns the effective persisted
+identity, including resumed continuations. Explicit cross-project writes use isolated satellite sessions; implicit writes stay in the host project.
+\`mem_session_end\` accepts only an optional assertion of the current DSH host session ID; the plugin
+resolves the effective persisted ID. Ordinary task completion does not end it.
+
+### PASSIVE CAPTURE
+
+DSH queues eligible top-level non-Engram tool outputs after redaction; only
+recognized structured learnings are persisted, not arbitrary output.
+Final assistant responses are not automatically captured. For significant learnings
+in a response, follow the canonical topic workflow before replying;
+a final \`## Key Learnings:\` section alone is not a persistence guarantee.
+
+### DELIVERY GUARANTEE
+
+Honestly report unavailable memory evidence; never claim unconfirmed persistence.
+Do not blindly repeat writes. Complete unrelated work even if bookkeeping fails.
+Do not add per-event learning sections or ceremonial delivery blocks.
+
+Memory operations are internal bookkeeping, never the user-facing answer. Complete required memory work before composing the completed-task reply; send the complete answer as the final message of the turn with no later tool calls. If memory work fails or needs follow-up, still send the answer.
+
+New sessions do not automatically inject historical memory. Start a new session
+with \`mem_context\` to recover relevant recent context.
+
+### WHEN TO SEARCH MEMORY
+
+Search when materially useful for recall or related work; mere project mentions do not require a search.
+When the user asks to recall past work:
+1. Start with \`mem_context\`, then search with 1–2 distinctive keywords.
+2. Ordinary \`mem_search\` is scoped to the detected active project; its default
+   \`match_mode:"all"\` means AND. For broad recall, use \`match_mode:"any"\` with
+   \`all_projects:true\`. If a scoped search is empty, retry once this way before
+   concluding no memory exists.
+3. After hits, narrow follow-up searches by project, type, or \`match_mode:"all"\`,
+   then use \`mem_get_observation\` for full content.
+
+### SESSION CLOSE PROTOCOL
+
+At significant explicit closure or handoff, call \`mem_session_summary\`
+with Goal, Instructions, Discoveries, Accomplished, Next Steps, and Relevant Files.
+Ordinary task completion or merely saying "done" does not require a session summary.
+If \`mem_session_summary\` fails because Engram cannot detect a project, ask the user
+which project is intended. Fix the project configuration or restart in its directory,
+verify with \`mem_current_project\`, then retry after project resolution succeeds.
+
+### AFTER COMPACTION
+
+When outcome-specific compaction recovery guidance is present, follow it. If a
+compacted summary appears without that guidance, save it immediately with
+\`mem_session_summary\`, then call \`mem_context\` before continuing.
+`;
+
+export { MEMORY_INSTRUCTIONS }
diff --git a/plugin/dsh/lib/queue.ts b/plugin/dsh/lib/queue.ts
new file mode 100644
index 0000000..eb04ff3
--- /dev/null
+++ b/plugin/dsh/lib/queue.ts
@@ -0,0 +1,68 @@
+interface Item {
+  job: () => Promise<unknown>
+  resolve: (value: unknown) => void
+  reject: (error: unknown) => void
+  unwatch: () => void
+}
+interface State { items: Item[]; running: boolean; closed: boolean; idle: Set<() => void> }
+export class WriteQueues {
+  private states = new Map<string, State>()
+  private warn: (message: string) => void
+  private failure: (error: unknown) => void
+  constructor(warn: (message: string) => void = () => {}, failure?: (error: unknown) => void) {
+    this.warn = warn
+    this.failure = failure ?? (error => this.warn(`Engram queued capture failed: ${error instanceof Error ? error.message : String(error)}`))
+  }
+  run<T>(id: string, job: () => Promise<T>, signal?: AbortSignal): Promise<T> {
+    if (signal?.aborted) return Promise.reject(signal.reason)
+    let state = this.states.get(id)
+    if (!state) { state = { items: [], running: false, closed: false, idle: new Set() }; this.states.set(id, state) }
+    const current = state
+    return new Promise<T>((resolve, reject) => {
+      const item: Item = { job, resolve: value => resolve(value as T), reject, unwatch: () => signal?.removeEventListener('abort', cancel) }
+      const cancel = () => {
+        const index = current.items.indexOf(item)
+        if (index >= 0) { current.items.splice(index, 1); item.unwatch(); reject(signal?.reason) }
+      }
+      current.items.push(item)
+      signal?.addEventListener('abort', cancel, { once: true })
+      if (!current.running) { current.running = true; queueMicrotask(() => { void this.pump(current) }) }
+    })
+  }
+  enqueue(id: string, job: () => Promise<unknown>): void {
+    void this.run(id, job).catch(error => this.failure(error))
+  }
+  private async pump(state: State): Promise<void> {
+    while (!state.closed && state.items.length) {
+      const item = state.items.shift()!
+      item.unwatch()
+      try { item.resolve(await item.job()) } catch (error) { item.reject(error) }
+    }
+    state.running = false
+    for (const notify of state.idle) notify()
+    state.idle.clear()
+  }
+  async drain(id: string, timeoutMs = 5000): Promise<boolean> {
+    const state = this.states.get(id)
+    if (!state?.running && !state?.items.length) return true
+    let notify: () => void = () => {}
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const idle = new Promise<boolean>(resolve => { notify = () => resolve(true); state!.idle.add(notify) })
+    const expired = new Promise<boolean>(resolve => { timer = setTimeout(() => resolve(false), timeoutMs) })
+    try {
+      const drained = await Promise.race([idle, expired])
+      if (!drained) this.warn('Engram write queue drain timed out; pending work remains queued')
+      return drained
+    } finally { clearTimeout(timer); state?.idle.delete(notify) }
+  }
+  dispose(id: string): void {
+    const state = this.states.get(id)
+    if (!state) return
+    state.closed = true
+    const pending = state.items.splice(0)
+    for (const item of pending) { item.unwatch(); item.reject(new Error('Engram queued work was disposed before dispatch')) }
+    if (pending.length) this.warn(`Engram write queue discarded ${pending.length} unstarted item(s)`)
+    this.states.delete(id)
+  }
+  close(): void { for (const id of this.states.keys()) this.dispose(id) }
+}
diff --git a/plugin/dsh/lib/redaction.ts b/plugin/dsh/lib/redaction.ts
new file mode 100644
index 0000000..8bce821
--- /dev/null
+++ b/plugin/dsh/lib/redaction.ts
@@ -0,0 +1,20 @@
+// Ported from plugin/pi/private-redaction.js. Explicit private blocks only;
+// credential-shaped redaction remains the Go server's responsibility.
+const PRIVATE_TAG_PATTERN = /<private>[\s\S]*?<\/private>/gi
+export function redactPrivateTags(value: string): string {
+  return value.replace(PRIVATE_TAG_PATTERN, '[REDACTED]')
+}
+export function redactUrlPath(path: string): string {
+  const redacted = redactPrivateTags(path)
+  const url = new URL(redacted, 'http://engram.local')
+  const params = new URLSearchParams()
+  for (const [key, value] of url.searchParams) params.append(key, redactPrivateTags(value))
+  const query = params.toString()
+  return `${url.pathname}${query ? '?' + query : ''}${url.hash}`
+}
+export function redactValue(value: unknown): unknown {
+  if (typeof value === 'string') return redactPrivateTags(value)
+  if (Array.isArray(value)) return value.map(redactValue)
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, redactValue(entry)]))
+  return value
+}
diff --git a/plugin/dsh/lib/runtime.ts b/plugin/dsh/lib/runtime.ts
new file mode 100644
index 0000000..7bc0468
--- /dev/null
+++ b/plugin/dsh/lib/runtime.ts
@@ -0,0 +1,82 @@
+import { Client, EngramUnavailableError } from './client.ts'
+import { Contract } from './contract.ts'
+import { Projects, agentCwd } from './project.ts'
+import type { Agent } from './project.ts'
+import { Server } from './server.ts'
+import { Satellites } from './satellite.ts'
+import type { WriteTarget } from './satellite.ts'
+import type { SessionState } from './session.ts'
+import { postObservationWithReplayRecovery } from './save-recovery.ts'
+import { Sessions } from './session.ts'
+import { WriteQueues } from './queue.ts'
+import { Capture } from './capture.ts'
+import { Compaction } from './compaction.ts'
+import { ConfigurationError, Diagnostics } from './diagnostics.ts'
+import type { DiagnosticLogger } from './diagnostics.ts'
+import type { Config } from './config.ts'
+
+export class Runtime {
+  readonly queue: WriteQueues
+  readonly capture: Capture
+  readonly compaction: Compaction
+  readonly warn: (message: string) => void
+  readonly report: (label: string, error: unknown) => void
+  private closed = false
+  readonly client: Client
+  readonly server: Server
+  readonly contract: Contract
+  readonly projects: Projects
+  readonly sessions: Sessions
+  readonly satellites: Satellites
+  constructor(config: Config, now = Date.now, logger: DiagnosticLogger = { warn() {}, error() {} }) {
+    const diagnostics = new Diagnostics(logger, config.token)
+    this.warn = message => diagnostics.warn(message)
+    this.report = (label, error) => diagnostics.report(label, error)
+    this.queue = new WriteQueues(this.warn, error => this.report('Engram queued capture failed', error))
+    this.capture = new Capture(this)
+    this.compaction = new Compaction(this)
+    this.client = new Client(config)
+    this.server = new Server(config, now)
+    this.contract = new Contract(this.client, () => this.server.localId)
+    this.projects = new Projects(this.client, now)
+    this.sessions = new Sessions(this.client, now, error => this.report('Engram session registration failed', error))
+    this.satellites = new Satellites(this.client, this.sessions, this.projects)
+    this.client.binding = () => this.contract.identity
+    this.client.onUnavailable = () => this.server.reset()
+    this.client.beforeDispatch = signal => this.qualify(signal)
+  }
+  private async qualify(signal?: AbortSignal): Promise<void> {
+    if (this.closed) throw new Error('Engram plugin was unloaded')
+    signal?.throwIfAborted()
+    try {
+      await this.server.ensure()
+      signal?.throwIfAborted()
+      await this.contract.check(signal)
+    } catch (error) {
+      if (error instanceof ConfigurationError) this.report('Engram runtime qualification failed', error)
+      if (error instanceof EngramUnavailableError) this.server.reset()
+      throw error
+    }
+  }
+  async prepare(agent: Agent, signal?: AbortSignal) {
+    const cwd = agentCwd(agent)
+    if (typeof agent.id !== 'string' || !agent.id) throw new Error('DSH agent.id is required')
+    await this.qualify(signal)
+    try { return await this.projects.resolve(cwd, signal) }
+    catch (error) {
+      if (error instanceof ConfigurationError) this.report('Engram project resolution failed', error)
+      throw error
+    }
+  }
+  async save(target: WriteTarget, body: (state: SessionState) => Record<string, unknown>, signal?: AbortSignal): Promise<unknown> {
+    const state = await this.satellites.register(target, signal)
+    return postObservationWithReplayRecovery(this.client, { ...body(state), session_id: state.effectiveId, project: state.project, project_provenance: target.project.provenance }, signal)
+  }
+  dispose(id: string): void {
+    this.satellites.dispose(id); this.queue.dispose(id); this.capture.endTurn(id); this.compaction.dispose(id); this.sessions.dispose(id)
+  }
+  close(): void {
+    this.closed = true; this.satellites.close(); this.queue.close(); this.capture.close(); this.compaction.close()
+    for (const id of this.sessions.states.keys()) this.sessions.dispose(id)
+  }
+}
diff --git a/plugin/dsh/lib/satellite.ts b/plugin/dsh/lib/satellite.ts
new file mode 100644
index 0000000..0acd25e
--- /dev/null
+++ b/plugin/dsh/lib/satellite.ts
@@ -0,0 +1,82 @@
+import type { Client } from './client.ts'
+import type { Agent, Project } from './project.ts'
+import type { Projects } from './project.ts'
+import type { Sessions, SessionState } from './session.ts'
+
+export interface WriteTarget { id: string; agentId: string; project: Project; satellite: boolean }
+const routedTools = new Set(['mem_save', 'mem_save_prompt', 'mem_session_summary', 'mem_session_finalize'])
+function canonical(value: string): string { return value.normalize('NFC').toLowerCase().trim().normalize('NFC').replace(/--+/g, '-').replace(/__+/g, '_') }
+export class SatelliteEndError extends Error {
+  readonly rootEnded = true
+  constructor(failures: string[]) { super(`Root session ended successfully; satellite cleanup failed: ${failures.join('; ')}. Retry mem_session_end explicitly to finish cleanup.`); this.name = 'SatelliteEndError' }
+}
+export class Satellites {
+  private client: Client
+  private sessions: Sessions
+  private projects: Projects
+  private known = new Map<string, Map<string, { target: WriteTarget; state: SessionState }>>()
+  private endedRoots = new Map<string, { id: string; result: unknown }>()
+  constructor(client: Client, sessions: Sessions, projects: Projects) { this.client = client; this.sessions = sessions; this.projects = projects }
+  async resolve(name: string, agent: Agent, root: Project, args: Record<string, unknown>, signal?: AbortSignal): Promise<WriteTarget> {
+    const implicit = { id: agent.id, agentId: agent.id, project: root, satellite: false }
+    if (!routedTools.has(name) || (args.project === undefined && args.cwd === undefined)) return implicit
+    const requested = typeof args.project === 'string' ? canonical(args.project) : undefined
+    if (requested && (requested === 'unknown' || /[\\/\x00-\x1f\x7f]/.test(requested))) throw new Error('Invalid explicit project')
+    const detected = typeof args.cwd === 'string' ? await this.projects.resolve(args.cwd, signal) : undefined
+    if (requested && detected && requested !== canonical(detected.project)) throw new Error('Explicit project does not match the project resolved from cwd')
+    const selected = requested ?? (detected ? canonical(detected.project) : root.project)
+    const project = { ...root, provenance: detected?.provenance ?? { source: 'explicit_override', directory: root.cwd, raw_project: args.project as string }, project: selected }
+    if (selected === canonical(root.project)) return { ...implicit, project: { ...project, project: root.project } }
+    return { id: `${agent.id}@${selected}`, agentId: agent.id, project, satellite: true }
+  }
+  async register(target: WriteTarget, signal?: AbortSignal): Promise<SessionState> {
+    const state = await this.sessions.register(target.id, target.project, signal, false, target.satellite)
+    if (target.satellite) {
+      const entries = this.known.get(target.agentId) ?? new Map()
+      entries.set(target.id, { target, state }); this.known.set(target.agentId, entries)
+    }
+    return state
+  }
+  async write(target: WriteTarget, path: string, body: Record<string, unknown>, signal?: AbortSignal): Promise<unknown> {
+    const state = await this.register(target, signal)
+    return this.client.request(path, { method: 'POST', signal, body: { ...body, session_id: state.effectiveId, project: state.project, project_provenance: target.project.provenance } })
+  }
+  async finalize(target: WriteTarget, summary: string, signal?: AbortSignal): Promise<unknown> {
+    try {
+      const result = await this.sessions.finalize(target.id, target.project, summary, signal, target.satellite)
+      if (target.satellite) this.known.get(target.agentId)?.delete(target.id)
+      return result
+    } catch (error) {
+      const state = this.sessions.states.get(target.id)
+      if (target.satellite && state) {
+        const entries = this.known.get(target.agentId) ?? new Map()
+        entries.set(target.id, { target, state }); this.known.set(target.agentId, entries)
+      }
+      throw error
+    }
+  }
+  async endRoot(agent: Agent, project: Project, summary?: string, signal?: AbortSignal): Promise<unknown> {
+    let ended = this.endedRoots.get(agent.id)
+    const current = this.sessions.states.get(agent.id)
+    if (!ended || (current && current.effectiveId !== ended.id)) {
+      const result = await this.sessions.end(agent.id, project, summary, signal) as { id: string }
+      ended = { id: result.id, result }; this.endedRoots.set(agent.id, ended)
+    }
+    const failures: string[] = []
+    const entries = this.known.get(agent.id)
+    for (const [id, entry] of entries ?? []) {
+      try { await this.sessions.end(id, entry.target.project, '', signal, entry.state); entries!.delete(id) }
+      catch (error) { failures.push(`${entry.target.project.project}: ${error instanceof Error ? error.message : String(error)}`) }
+      finally { this.sessions.invalidate(id) }
+    }
+    this.sessions.invalidate(agent.id)
+    if (failures.length) throw new SatelliteEndError(failures)
+    this.endedRoots.delete(agent.id); this.known.delete(agent.id)
+    return ended.result
+  }
+  dispose(id: string): void {
+    for (const satellite of this.known.get(id)?.keys() ?? []) this.sessions.dispose(satellite)
+    this.known.delete(id); this.endedRoots.delete(id)
+  }
+  close(): void { for (const id of this.known.keys()) this.dispose(id); this.endedRoots.clear() }
+}
diff --git a/plugin/dsh/lib/save-recovery.ts b/plugin/dsh/lib/save-recovery.ts
new file mode 100644
index 0000000..8103eca
--- /dev/null
+++ b/plugin/dsh/lib/save-recovery.ts
@@ -0,0 +1,76 @@
+// Ported from Pi postObservationWithReplayRecovery. The Go ledger alone decides
+// whether a save committed; this exception applies only to native mem_save.
+import { randomUUID } from 'node:crypto'
+import { setTimeout as delay } from 'node:timers/promises'
+import { EngramHttpError, EngramUnknownOutcomeError } from './client.ts'
+import type { Client } from './client.ts'
+import { redactValue } from './redaction.ts'
+
+interface Attempt { response?: Response; data?: unknown }
+interface Timing { totalMs?: number; postMs?: number; getMs?: number; backoffMs?: number }
+function receipt(value: unknown, lookup: boolean): boolean {
+  const data = value as { id?: unknown; status?: unknown } | null
+  return !!data && Number.isSafeInteger(data.id) && Number(data.id) > 0
+    && (lookup ? data.status === 'committed' : data.status === undefined || data.status === 'saved')
+}
+export async function postObservationWithReplayRecovery(client: Client, body: Record<string, unknown>, signal?: AbortSignal, timing: Timing = {}): Promise<unknown> {
+  signal?.throwIfAborted()
+  await client.beforeDispatch?.(signal)
+  const binding = client.binding?.(), endpoint = client.url, token = client.token
+  const operation = randomUUID()
+  const destinations = Object.freeze({ post: `${endpoint}/observations`, get: `${endpoint}/observations/save-result?${new URLSearchParams({ operation_id: operation })}` })
+  const headers = Object.freeze({ ...client.headers('/observations') })
+  const bytes = JSON.stringify({ ...redactValue(body) as Record<string, unknown>, operation_id: operation })
+  const deadline = performance.now() + (timing.totalMs ?? 7500)
+  // Neither logs nor thrown errors carry the operation UUID. All transport/body
+  // ambiguity becomes a generic unknown result; never echo a fetch URL.
+  const unknown = () => { throw new EngramUnknownOutcomeError() }
+  const sanitize = (value: unknown): unknown => {
+    if (typeof value === 'string') return value.split(operation).join('[REDACTED]')
+    if (Array.isArray(value)) return value.map(sanitize)
+    if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key.split(operation).join('[REDACTED]'), sanitize(entry)]))
+    return value
+  }
+  const httpError = (attempt: Attempt) => new EngramHttpError(attempt.response!.status, sanitize(attempt.data ?? null))
+  async function attempt(method: 'POST' | 'GET'): Promise<Attempt> {
+    signal?.throwIfAborted()
+    const remaining = deadline - performance.now()
+    if (remaining <= 0) return {}
+    const controller = new AbortController()
+    let stop: (error: unknown) => void = () => {}
+    const stopped = new Promise<never>((_resolve, reject) => { stop = reject })
+    const abort = () => { controller.abort(signal?.reason); stop(signal?.reason) }
+    const timer = setTimeout(() => { controller.abort(); stop(new Error('Save recovery deadline reached')) }, Math.min(remaining, method === 'POST' ? timing.postMs ?? 3000 : timing.getMs ?? 1000))
+    signal?.addEventListener('abort', abort, { once: true })
+    try {
+      const exchange = async (): Promise<Attempt> => {
+        await client.beforeDispatch?.(controller.signal)
+        controller.signal.throwIfAborted()
+        if (client.url !== endpoint || client.token !== token || client.binding?.() !== binding) return {}
+        const response = await (client.options.fetch ?? fetch)(method === 'POST' ? destinations.post : destinations.get, { method, headers, body: method === 'POST' ? bytes : undefined, signal: controller.signal })
+        if (response.status === 204) return { response, data: null }
+        try { return { response, data: await response.json() } }
+        catch { signal?.throwIfAborted(); return { response } }
+      }
+      return await Promise.race([exchange(), stopped])
+    } catch { signal?.throwIfAborted(); return {} }
+    finally { clearTimeout(timer); signal?.removeEventListener('abort', abort); controller.abort() }
+  }
+  const initial = await attempt('POST')
+  if (initial.response?.ok && receipt(initial.data, false)) return initial.data
+  if (initial.response && !initial.response.ok) throw httpError(initial)
+  const lookup = await attempt('GET')
+  if (lookup.response?.ok && receipt(lookup.data, true)) return lookup.data
+  const miss = lookup.data as { code?: unknown; error?: unknown } | null
+  if (lookup.response?.status !== 404 || miss?.code !== 'observation_save_result_not_found' || miss.error !== 'no committed result found for operation_id') return unknown()
+  signal?.throwIfAborted()
+  const remaining = deadline - performance.now(), backoff = timing.backoffMs ?? 250
+  if (remaining <= backoff) return unknown()
+  try { await delay(backoff, undefined, { signal }) } catch (error) { signal?.throwIfAborted(); throw error }
+  const replay = await attempt('POST')
+  if (replay.response?.ok && receipt(replay.data, false)) return replay.data
+  if (replay.response && !replay.response.ok && ![409, 410].includes(replay.response.status)) throw httpError(replay)
+  const final = await attempt('GET')
+  if (final.response?.ok && receipt(final.data, true)) return final.data
+  return unknown()
+}
diff --git a/plugin/dsh/lib/server.ts b/plugin/dsh/lib/server.ts
new file mode 100644
index 0000000..2d991fd
--- /dev/null
+++ b/plugin/dsh/lib/server.ts
@@ -0,0 +1,95 @@
+import { execFile, spawn } from 'node:child_process'
+import { promisify } from 'node:util'
+import { setTimeout as delay } from 'node:timers/promises'
+import { hasErrorCode, EngramUnavailableError } from './client.ts'
+import { ConfigurationError } from './diagnostics.ts'
+import type { Config } from './config.ts'
+
+const run = promisify(execFile)
+export class OwnershipError extends ConfigurationError {
+  constructor(message: string, key = message) { super('ownership', message, key); this.name = 'OwnershipError' }
+}
+export function startupBackoffMs(failures: number): number { return Math.min(60000, 1000 * 2 ** (failures - 1)) }
+// SemVer boundary ported from plugin/pi/index.ts:isPreIdentityEngramVersion.
+function legacyVersion(version: unknown): boolean {
+  if (typeof version !== 'string') return false
+  const match = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/.exec(version)
+  if (!match) return false
+  const [major, minor, patch] = match.slice(1, 4).map(Number)
+  if (major! < 2) return true
+  if (major !== 2 || minor !== 0 || patch !== 0) return false
+  const pre = match[4]?.split('.')
+  if (!pre || pre.some(s => /^\d+$/.test(s) && s.length > 1 && s.startsWith('0'))) return false
+  const boundary = ['rc', '11']
+  for (let i = 0; i < Math.max(pre.length, boundary.length); i++) {
+    const a = pre[i], b = boundary[i]
+    if (a === undefined) return true
+    if (b === undefined) return false
+    if (a === b) continue
+    const an = /^\d+$/.test(a), bn = /^\d+$/.test(b)
+    return an && bn ? Number(a) < Number(b) : an !== bn ? an : a < b
+  }
+  return false
+}
+export function ownership(health: { instance_id?: unknown; version?: unknown }, expected: string): 'ready' | 'foreign' | 'legacy' | 'identity_missing' {
+  if (typeof health.instance_id !== 'string' || !health.instance_id) return legacyVersion(health.version) ? 'legacy' : 'identity_missing'
+  return health.instance_id === expected ? 'ready' : 'foreign'
+}
+export class Server {
+  readonly config: Config
+  localId?: string
+  private flight?: Promise<void>
+  private ready = false
+  private failure?: Error
+  private retryAt = 0
+  private failures = 0
+  readonly now: () => number
+  constructor(config: Config, now = Date.now) { this.config = config; this.now = now }
+  reset(): void {
+    // Never discard an active initialization or its failure/backoff state.
+    if (!this.config.url && this.ready) { this.flight = undefined; this.ready = false }
+  }
+  ensure(): Promise<void> {
+    if (this.flight) return this.flight
+    if (this.failure && this.now() < this.retryAt) return Promise.reject(this.failure)
+    this.flight = this.initialize().then(() => {
+      this.ready = true; this.failure = undefined; this.failures = 0
+    }, error => {
+      this.flight = undefined
+      this.failure = error instanceof Error ? error : new Error('Engram startup failed')
+      this.retryAt = this.now() + (error instanceof OwnershipError ? 5000 : startupBackoffMs(++this.failures))
+      throw this.failure
+    })
+    return this.flight
+  }
+  private async probe(): Promise<void> {
+    const res = await fetch(`http://127.0.0.1:${this.config.port}/health`, { signal: AbortSignal.timeout(500) })
+    if (!res.ok) throw new Error('Engram health unavailable')
+    const health = await res.json() as Record<string, unknown>
+    const state = ownership(health, this.localId!)
+    if (state !== 'ready') throw new OwnershipError(`Engram ownership check failed: ${state}. No process was adopted or terminated.`, `${state}:${String(health.instance_id ?? '')}`)
+  }
+  private async initialize(): Promise<void> {
+    if (this.config.url) return
+    let id: string
+    try { id = (await run(this.config.engramBin, ['instance-id'], { timeout: 2000, maxBuffer: 4096 })).stdout.trim() }
+    catch { throw new OwnershipError('Engram instance-id failed; verify ENGRAM_BIN and upgrade Engram') }
+    if (!/^[a-f0-9]{32}$/.test(id)) throw new OwnershipError('Engram instance-id must be 32 hexadecimal characters')
+    this.localId = id
+    try { await this.probe(); return }
+    catch (error) {
+      if (!hasErrorCode(error, 'ECONNREFUSED')) throw error
+    }
+    // Shared serve deliberately survives DSH. Never kill this process.
+    const child = spawn(this.config.engramBin, ['serve'], { detached: true, stdio: 'ignore', env: { ...process.env, ENGRAM_PORT: String(this.config.port) } })
+    await new Promise<void>((resolve, reject) => { child.once('spawn', resolve); child.once('error', () => reject(new Error('Could not spawn Engram serve'))) })
+    child.unref()
+    const deadline = this.now() + 10000
+    while (this.now() < deadline) {
+      try { await this.probe(); return }
+      catch (error) { if (!hasErrorCode(error, 'ECONNREFUSED')) throw error }
+      await delay(100)
+    }
+    throw new EngramUnavailableError()
+  }
+}
diff --git a/plugin/dsh/lib/session.ts b/plugin/dsh/lib/session.ts
new file mode 100644
index 0000000..a66455c
--- /dev/null
+++ b/plugin/dsh/lib/session.ts
@@ -0,0 +1,148 @@
+import { EngramHttpError } from './client.ts'
+import { ConfigurationError } from './diagnostics.ts'
+import type { Client } from './client.ts'
+import type { Project } from './project.ts'
+
+export interface SessionState extends Project { effectiveId: string; registeredAt: number; isolated?: boolean }
+export class SessionProjectConflictError extends Error {
+  constructor() { super('DSH session belongs to another Engram project. Start a new DSH agent in this project.'); this.name = 'SessionProjectConflictError' }
+}
+interface Closing {
+  state: SessionState
+  flight?: Promise<unknown>
+  uncertain: boolean
+}
+export class Sessions {
+  readonly client: Client
+  readonly now: () => number
+  readonly states = new Map<string, SessionState>()
+  private finalizations = new Map<string, Closing>()
+  private endings = new Map<string, Closing>()
+  private generations = new Map<string, object>()
+  private flights = new Map<string, Promise<SessionState>>()
+  private reportConfiguration: (error: ConfigurationError) => void
+  constructor(client: Client, now = Date.now, reportConfiguration: (error: ConfigurationError) => void = () => {}) {
+    this.client = client; this.now = now; this.reportConfiguration = reportConfiguration
+  }
+  invalidate(id: string): void {
+    this.states.delete(id); this.generations.delete(id); this.flights.delete(id)
+  }
+  dispose(id: string): void { this.invalidate(id); this.finalizations.delete(id); this.endings.delete(id) }
+  async register(id: string, project: Project, signal?: AbortSignal, force = false, isolated = false): Promise<SessionState> {
+    signal?.throwIfAborted()
+    if (this.finalizations.has(id) || this.endings.has(id)) throw new Error('DSH session is closing or finalized; retry only the explicit session close tool with the same host identity')
+    if (!id) throw new Error('DSH agent.id is required')
+    const state = this.states.get(id)
+    if (state && !!state.isolated !== isolated) throw new Error('Session isolation mode does not match the requested registration')
+    if (state && (state.project !== project.project || state.cwd !== project.cwd)) throw new SessionProjectConflictError()
+    if (state && !force && this.now() - state.registeredAt <= 60000) return state
+    const pending = this.flights.get(id)
+    if (pending) {
+      const result = await pending
+      signal?.throwIfAborted()
+      if (!!result.isolated !== isolated) throw new Error('Session isolation mode does not match the requested registration')
+      if (result.project !== project.project || result.cwd !== project.cwd) throw new SessionProjectConflictError()
+      return result
+    }
+    const generation = {}
+    this.generations.set(id, generation)
+    const flight = this.create(id, project, generation, signal, isolated).catch(error => {
+      if (error instanceof ConfigurationError) this.reportConfiguration(error)
+      throw error
+    })
+    this.flights.set(id, flight)
+    try { return await flight } finally { if (this.flights.get(id) === flight) this.flights.delete(id) }
+  }
+  private async create(id: string, project: Project, generation: object, signal: AbortSignal | undefined, isolated: boolean): Promise<SessionState> {
+    const capability = async (dispatchSignal?: AbortSignal) => {
+      const health = await this.client.request<{ capabilities?: { root_session_resume?: boolean; isolated_session_registration?: boolean } }>('/health', { signal: dispatchSignal })
+      if (isolated ? health?.capabilities?.isolated_session_registration !== true : health?.capabilities?.root_session_resume !== true) {
+        const required = isolated ? 'isolated_session_registration' : 'root_session_resume'
+        throw new ConfigurationError(required, 'Engram ' + required + ' capability is required; upgrade Engram and restart serve')
+      }
+    }
+    if (!isolated) await capability(signal)
+    let ack: { id?: unknown; status?: unknown }
+    try {
+      ack = await this.client.request('/sessions', { method: 'POST', signal, ...(isolated ? { beforeDispatch: capability } : {}), body: {
+        id, project: project.project, ...(isolated ? { isolated: true } : { directory: project.cwd }), ownership_mode: 'project_owned', resume: true, project_provenance: project.provenance,
+      } })
+    } catch (error) {
+      if (error instanceof EngramHttpError && error.status === 409 && error.code === 'session_project_conflict') throw new SessionProjectConflictError()
+      throw error
+    }
+    const effective = ack?.id
+    const suffix = typeof effective === 'string' && effective.startsWith(`${id}:resume:`) ? effective.slice(`${id}:resume:`.length) : ''
+    if (ack?.status !== 'created' || typeof effective !== 'string' || !(effective === id || /^[1-9]\d*$/.test(suffix))) throw new Error('Invalid Engram session registration acknowledgement')
+    const state = { ...project, effectiveId: effective, registeredAt: this.now(), isolated }
+    if (this.generations.get(id) !== generation) throw new Error('Engram session registration was invalidated during dispatch')
+    this.states.set(id, state)
+    return state
+  }
+  async write(id: string, project: Project, body: Record<string, unknown> | ((state: SessionState) => Record<string, unknown>), signal?: AbortSignal): Promise<unknown> {
+    const state = await this.register(id, project, signal)
+    return this.client.request('/observations', { method: 'POST', signal, body: {
+      ...(typeof body === 'function' ? body(state) : body), session_id: state.effectiveId, project: state.project, project_provenance: project.provenance,
+    } })
+  }
+  async end(id: string, project: Project, summary = '', signal?: AbortSignal, confirmed?: SessionState): Promise<unknown> {
+    if (this.finalizations.has(id)) throw new Error('Session finalization is unresolved; explicitly confirm it before ending this session')
+    const pending = this.endings.get(id)
+    if (pending?.flight) return pending.flight
+    const state = pending?.state ?? confirmed ?? await this.register(id, project, signal)
+    const raced = this.endings.get(id)
+    if (raced?.flight) return raced.flight
+    const binding = raced ?? { state, uncertain: false }
+    this.endings.set(id, binding)
+    const flight = this.client.request<{ id?: unknown; status?: unknown }>(
+      '/sessions/' + encodeURIComponent(binding.state.effectiveId) + '/end',
+      { method: 'POST', signal, body: { summary, project_provenance: project.provenance } },
+    ).then(result => {
+      if (result?.id !== binding.state.effectiveId || result.status !== 'completed') throw new Error('Session end outcome is unknown; retry mem_session_end explicitly with the same host identity')
+      this.invalidate(id); this.endings.delete(id)
+      return result
+    }).catch(error => {
+      if (error instanceof EngramHttpError && error.status >= 400 && error.status < 500 && !binding.uncertain) this.endings.delete(id)
+      else binding.uncertain = true
+      throw error
+    })
+    binding.flight = flight
+    try { return await flight } finally { binding.flight = undefined }
+  }
+  async finalize(id: string, project: Project, summary: string, signal?: AbortSignal, isolated = false): Promise<unknown> {
+    let binding = this.finalizations.get(id)
+    if (binding?.flight) return binding.flight
+    if (!binding) {
+      const state = await this.register(id, project, signal, false, isolated)
+      binding = this.finalizations.get(id)
+      if (binding?.flight) return binding.flight
+      if (!binding) { binding = { state, uncertain: false }; this.finalizations.set(id, binding) }
+    }
+    const pinned = binding
+    // Pi's finalization pins identity before dispatch. Unknown acknowledgement
+    // stays closed; only an explicit retry may query Go's finalization journal.
+    const flight = this.client.request<Record<string, unknown>>(
+      '/sessions/' + encodeURIComponent(pinned.state.effectiveId) + '/finalize',
+      { method: 'POST', signal, body: { project: pinned.state.project, summary } },
+    ).then(result => {
+      if (!result || result.session_id !== pinned.state.effectiveId
+        || !['finalized', 'already_finalized'].includes(String(result.state))
+        || !Number.isSafeInteger(result.summary_id) || Number(result.summary_id) < 1
+        || typeof result.summary_sync_id !== 'string' || !result.summary_sync_id
+        || result.already_finalized !== (result.state === 'already_finalized')) {
+        throw new Error('Session finalization outcome is unknown; retry mem_session_finalize explicitly with the same host identity')
+      }
+      pinned.uncertain = false
+      this.invalidate(id); this.finalizations.delete(id)
+      return result
+    }).catch(error => {
+      const refused = error instanceof EngramHttpError && error.status >= 400 && error.status < 500 && error.code !== 'session_already_ended'
+      if (refused && !pinned.uncertain) this.finalizations.delete(id)
+      else pinned.uncertain = true
+      throw error
+    })
+    pinned.flight = flight
+    try { return await flight } finally { pinned.flight = undefined }
+  }
+
+}
