+  await assert.rejects(h.tools.mem_session_finalize.execute(toolArgs.mem_session_finalize, h.exec), EngramUnknownOutcomeError)
+  await assert.rejects(h.tools.mem_save.execute(toolArgs.mem_save, h.exec), /closing/)
+  await assert.rejects(h.tools.mem_session_finalize.execute(toolArgs.mem_session_finalize, h.exec), EngramUnknownOutcomeError)
