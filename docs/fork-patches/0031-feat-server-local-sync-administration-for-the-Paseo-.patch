+	for _, input := range []string{"密码输入处", "密码 输入处", "我先找下密码，稍后再告诉你", "我先找下密码\n后面是普通中文句子", "密码 abc", "密码:abc"} {
+		if masked, reasons := MaskPromptSecrets(input); masked != input || len(reasons) != 0 {
