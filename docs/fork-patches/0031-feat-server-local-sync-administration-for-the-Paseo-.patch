+func TestMaskPromptSecretsConversationReplies(t *testing.T) {
+	question := "[Assistant] 请提供路由器后台管理密码。" + strings.Repeat("等待说明", 80) + "\n"
+	for _, prefix := range []string{"", "[User] ", "[用户] ", "User: ", "user:\t", "用户："} {
