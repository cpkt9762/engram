+	if scan.Code != 200 {
+		t.Fatalf("scan: %d %s", scan.Code, scan.Body.String())
+	}
+	if strings.Contains(scan.Body.String(), "Zq9-FAKE-SECRET") {
+		t.Fatal("secret leaked")
+	}
+	var result struct {
+		ScanToken string `json:"scan_token"`
+		Items     []any  `json:"items"`
+		Complete  bool   `json:"complete"`
