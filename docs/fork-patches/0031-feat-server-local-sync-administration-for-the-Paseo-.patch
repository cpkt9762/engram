+		defer deadline.Stop()
+		ticker := time.NewTicker(10 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			if ready() {
+				return
+			}
+			select {
+			case <-deadline.C:
+				t.Fatal("timeout: " + label)
+			case <-ticker.C:
+			}
+		}
+	}
