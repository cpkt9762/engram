+	request := func(path, host, origin string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest("DELETE", "http://127.0.0.1"+path, nil)
+		r.Host = host
+		r.Header.Set("Authorization", "Bearer fake-stop-token")
