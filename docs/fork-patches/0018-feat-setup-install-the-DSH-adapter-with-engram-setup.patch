@@ -0,0 +1,29 @@
+export interface Config { url?: string; port: number; engramBin: string; token: string }
+
+function optionalEnvironmentValue(value: string | undefined): string | undefined {
+  return value?.trim() || undefined
+}
+// Keep this exact declaration compatible with internal/setup.patchEngramBINLine.
+const ENGRAM_BIN = optionalEnvironmentValue(process.env.ENGRAM_BIN) ?? "engram"
+
+export function parseConfig(raw: unknown, env: NodeJS.ProcessEnv = process.env): Config {
+  if (raw !== undefined && (raw === null || typeof raw !== 'object' || Array.isArray(raw))) throw new Error('config must be an object')
+  const input = (raw ?? {}) as Record<string, unknown>
+  const string = (key: string, value: unknown): string | undefined => {
+    if (value === undefined) return undefined
+    if (typeof value !== 'string' || !value.trim()) throw new Error(`${key} must be a non-empty string`)
+    return value.trim()
+  }
+  const url = string('url', input.url ?? optionalEnvironmentValue(env.ENGRAM_URL))
+  if (url) {
+    let parsed: URL
+    try { parsed = new URL(url) } catch { throw new Error('url must be an HTTP(S) URL') }
+    if (!['http:', 'https:'].includes(parsed.protocol) || parsed.username || parsed.password || parsed.search || parsed.hash) throw new Error('url must be an HTTP(S) URL without credentials, query or fragment')
+  }
+  const portInput = input.port ?? optionalEnvironmentValue(env.ENGRAM_PORT) ?? 7437
+  if (input.port !== undefined && typeof input.port !== 'number') throw new Error('port must be an integer')
+  const port = typeof portInput === 'string' && /^\d+$/.test(portInput) ? Number(portInput) : portInput
+  if (typeof port !== 'number' || !Number.isInteger(port) || port < 1 || port > 65535) throw new Error('port must be an integer from 1 to 65535')
+  const engramBin = string('engramBin', input.engramBin ?? optionalEnvironmentValue(env.ENGRAM_BIN)) ?? ENGRAM_BIN
+  return { url: url?.replace(/\/+$/, ''), port, engramBin, token: env.ENGRAM_HTTP_TOKEN ?? '' }
+}
diff --git a/internal/setup/plugins/dsh/lib/contract.ts b/internal/setup/plugins/dsh/lib/contract.ts
new file mode 100644
index 0000000..7f7d2dd
--- /dev/null
+++ b/internal/setup/plugins/dsh/lib/contract.ts
@@ -0,0 +1,56 @@
+import { readFileSync } from 'node:fs'
+import { isDeepStrictEqual } from 'node:util'
+import { hasErrorCode, EngramUnavailableError } from './client.ts'
+import { ConfigurationError } from './diagnostics.ts'
+import type { Client } from './client.ts'
+
+const expected = JSON.parse(readFileSync(new URL('../runtime-contract.json', import.meta.url), 'utf8'))
+export class RuntimeContractError extends ConfigurationError {
+  constructor(reason: string) {
+    super('runtime-contract', `engram-dsh rejected the Engram runtime contract: ${reason}. Expected ${expected.contract_id}. Upgrade Engram and restart serve and DSH. 升级 Engram、重启 serve 和 DSH。Memory dispatch was blocked.`)
+    this.name = 'RuntimeContractError'
+  }
+}
+// Ported from plugin/pi/runtime-contract.js: compare the entire Go projection,
+// excluding only bounded instance_id. Never infer authority from a digest or version.
+export function runtimeContractIdentity(value: unknown): string {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new RuntimeContractError('malformed contract')
+  const { instance_id, ...projection } = value as Record<string, unknown>
+  if (typeof instance_id !== 'string' || !instance_id.trim() || instance_id.length > 128) throw new RuntimeContractError('missing or malformed instance identity')
+  if (!isDeepStrictEqual(projection, expected)) throw new RuntimeContractError('projection mismatch')
+  return instance_id
+}
+export class Contract {
+  readonly client: Client
+  readonly localId: () => string | undefined
+  private accepted?: string
+  constructor(client: Client, localId: () => string | undefined = () => undefined) { this.client = client; this.localId = localId }
+  get identity(): string | undefined { return this.accepted }
+  async check(signal?: AbortSignal): Promise<void> {
+    const timeout = AbortSignal.timeout(3000)
+    let reader: ReadableStreamDefaultReader<Uint8Array> | undefined
+    try {
+      const res = await fetch(`${this.client.url}/runtime-contract`, { headers: this.client.headers('/runtime-contract'), signal: signal ? AbortSignal.any([timeout, signal]) : timeout })
+      if (!res.ok || !res.body) throw new RuntimeContractError('missing or unavailable contract')
+      reader = res.body.getReader()
+      const chunks: Uint8Array[] = []
+      let size = 0
+      for (;;) {
+        const item = await reader.read()
+        if (item.done) break
+        size += item.value.byteLength
+        if (size > 65536) throw new RuntimeContractError('oversized response (64 KiB limit)')
+        chunks.push(item.value)
+      }
+      const identity = runtimeContractIdentity(JSON.parse(Buffer.concat(chunks).toString('utf8')))
+      if (this.localId() && identity !== this.localId()) throw new RuntimeContractError('local instance mismatch')
+      if (this.accepted && identity !== this.accepted) throw new RuntimeContractError('server identity changed; restart DSH')
+      this.accepted = identity
+    } catch (error) {
+      signal?.throwIfAborted()
+      if (hasErrorCode(error, 'ECONNREFUSED')) throw new EngramUnavailableError()
+      if (error instanceof RuntimeContractError) throw error
+      throw new RuntimeContractError('unreadable or incompatible contract')
+    } finally { await reader?.cancel().catch(() => {}) }
+  }
+}
diff --git a/internal/setup/plugins/dsh/lib/diagnostics.ts b/internal/setup/plugins/dsh/lib/diagnostics.ts
new file mode 100644
index 0000000..5413e1c
--- /dev/null
+++ b/internal/setup/plugins/dsh/lib/diagnostics.ts
@@ -0,0 +1,37 @@
+import { redactPrivateTags } from './redaction.ts'
+
+export class ConfigurationError extends Error {
+  readonly diagnosticKey: string
+  constructor(category: string, message: string, key = message) {
+    super(message)
+    this.name = 'ConfigurationError'
+    this.diagnosticKey = `${category}:${key}`
+  }
+}
+export interface DiagnosticLogger {
+  warn(format: string, ...args: unknown[]): void
+  error(format: string, ...args: unknown[]): void
+}
+export class Diagnostics {
+  private logger: DiagnosticLogger
+  private token: string
+  private reported = new Set<string>()
+  constructor(logger: DiagnosticLogger, token: string) { this.logger = logger; this.token = token }
+  private safe(message: string): string {
+    const redacted = redactPrivateTags(message)
+    return this.token ? redacted.split(this.token).join('[REDACTED]') : redacted
+  }
+  warn(message: string): void {
+    try { this.logger.warn('%s', this.safe(message)) } catch { /* Logs must not break host lifecycle. */ }
+  }
+  report(label: string, error: unknown): void {
+    const message = this.safe(error instanceof Error ? error.message : String(error))
+    if (error instanceof ConfigurationError) {
+      if (this.reported.has(error.diagnosticKey)) return
+      this.reported.add(error.diagnosticKey)
+      try { this.logger.error(`${label}: %s`, message) } catch { /* Logs must not break host lifecycle. */ }
+      return
+    }
+    try { this.logger.warn(`${label}: %s`, message) } catch { /* Logs must not break host lifecycle. */ }
+  }
+}
