From 5190915defbefaf626611387341b25118f15496a Mon Sep 17 00:00:00 2001
From: cpkt9762 <cpkt9762@163.com>
Date: Mon, 26 Oct 2026 14:09:54 +0800
Subject: [PATCH] test(serve): keep stdin open in the owned startup failure
 test

TestServeOwnedStartupFailure left the child's stdin unset, so the child read
EOF from /dev/null immediately. An owned server treats stdin EOF as parent
death: it cancels startup, and a cancelled startup exits 0. When that EOF won
the race against the store failure under test, the test reported "expected
startup failure". That happened under -race on Linux, both on the fork's first
CI run and on upstream main (62374d4).

The child now gets a pipe that stays open for the whole run. With a 500 ms
delay injected at store start, the old test fails every time and the new one
passes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cmd/engram/serve_owned_test.go | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/cmd/engram/serve_owned_test.go b/cmd/engram/serve_owned_test.go
index 6a61067..73ce191 100644
--- a/cmd/engram/serve_owned_test.go
+++ b/cmd/engram/serve_owned_test.go
@@ -103,7 +103,17 @@ func TestServeOwnedStartupFailure(t *testing.T) {
 	if err := os.WriteFile(dir, []byte("not a store"), 0600); err != nil {
 		t.Fatal(err)
 	}
+	// Hold stdin open: an owned child treats stdin EOF as parent death and
+	// cancels startup, and a cancelled startup exits 0. With /dev/null that
+	// EOF races the store failure under test (seen under -race on Linux).
+	stdin, parent, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = parent.Close() }()
+	defer func() { _ = stdin.Close() }()
 	var stdout, stderr bytes.Buffer
+	cmd.Stdin = stdin
 	cmd.Stdout = &stdout
 	cmd.Stderr = &stderr
 	if err := cmd.Run(); err == nil {
