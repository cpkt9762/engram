From 37b6738272538e40491d1e966864c1c8e5ec864a Mon Sep 17 00:00:00 2001
From: cpkt9762 <cpkt9762@163.com>
Date: Sun, 1 Nov 2026 04:18:28 +0800
Subject: [PATCH] fix(lint): check Close errors and use a tagged switch in the
 new code

The first CI run on the Paseo adapter and the cloud auto-grant patches
failed golangci-lint. CI runs it with --new-from-patch, so only added lines
count, and the new code had six unchecked rows.Close or
response.Body.Close calls (0031 and 0034) and one if-chain on tc.name in the
0034 tests that wanted a tagged switch.

Use the repository's defer func() { _ = x.Close() }() form and a switch.
No behavior change.

Reproduced and verified locally with golangci-lint v2.13.2, the CI version:
golangci-lint run --new-from-rev=7f357c9 --max-same-issues=0
--max-issues-per-linter=0 ./... now reports 0 issues. The default limit of
three identical messages hides further findings after the first fixes.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 internal/cloud/cloudserver/auto_grant_test.go | 8 ++++----
 internal/cloud/cloudstore/auto_grant.go       | 2 +-
 internal/server/sync_policy_test.go           | 4 ++--
 internal/server/sync_unenrollment_test.go     | 8 ++++----
 internal/store/sync_admin.go                  | 4 ++--
 5 files changed, 13 insertions(+), 13 deletions(-)

diff --git a/internal/cloud/cloudserver/auto_grant_test.go b/internal/cloud/cloudserver/auto_grant_test.go
index 5c4e373..1c9e596 100644
--- a/internal/cloud/cloudserver/auto_grant_test.go
+++ b/internal/cloud/cloudserver/auto_grant_test.go
@@ -383,12 +383,12 @@ func TestAutoGrantEveryCallSite(t *testing.T) {
 		t.Run(tc.name, func(t *testing.T) {
 			f := newAutoGrantFake()
 			var st ChunkStore = newFakeMutationStore()
-			if tc.name == "session authority" {
+			switch tc.name {
+			case "session authority":
 				st = &authorityTestStore{}
-			} else if tc.name == "pair claim" {
+			case "pair claim":
 				st = &pairClaimStore{owner: "alpha"}
-			}
-			if tc.name == "chunk pull" {
+			case "chunk pull":
 				st = &fakeStore{chunks: map[string][]byte{"chunk": []byte(`{}`)}}
 			}
 			w := autoGrantRequest(autoGrantServer(st, f, true, 200), tc.method, tc.path, tc.body)
