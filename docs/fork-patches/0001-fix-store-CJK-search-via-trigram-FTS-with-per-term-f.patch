@@ -3178,7 +3195,35 @@ func (s *Store) Search(query string, opts SearchOptions) ([]SearchResult, error)
 		JOIN observations o ON o.id = fts.rowid
 		WHERE observations_fts MATCH ? AND o.deleted_at IS NULL
